# Cloudflare Pages serves everything outside /_app/immutable/* with its default
# `public, max-age=14400, must-revalidate` (and `max-age=0` for JSON). That
# default is wrong for this site's render data: a repeat visitor re-validated
# every letter SVG, arrow, prop, grid, font, and arrow-placement JSON against
# the origin on every load — ~200 blocking conditional GETs, all returning 304,
# stretching the homepage's asset tail past 12s (measured 2026-08-09: the 250th
# request started at 12,890ms while `load` fired at 1,879ms).
#
# These paths are all build-time TKA geometry — regenerated by scripts, never
# written at runtime. They are NOT content-hashed, so `immutable` would strand
# a corrected glyph in caches forever. `stale-while-revalidate` is the right
# tool: the browser paints from cache with zero network wait and refreshes in
# the background, so a change lands on the visitor's next load instead of
# costing every visitor a round trip on every load.
#
# Rules apply in order and later rules win for the same header, so the
# exact-path immutable entries at the bottom keep their stronger policy.

# Letters, arrows, props, grids, numbers, notation glyphs — the pictograph
# render set. Highest request count on the site by a wide margin.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Arrow placement tables, pictograph dataframes, layout options. Cloudflare's
# JSON default is max-age=0, which made every one of these a guaranteed round
# trip even though they only change when the dataframe is regenerated.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted webfonts. Rebuilt rarely (pnpm font:build) and render-blocking
# for the brand typefaces, so they get the longest non-immutable window.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

# The boot Overture's pool scenes keep a fixed name, so they revalidate.
/boot/*
  Cache-Control: public, no-cache

# The pictograph dataframes ship UNCOMPRESSED, and the app fetches all four:
# 449 KB of transfer that compresses to roughly 45 KB. Cloudflare only
# auto-compresses content types on its allowlist, and `text/csv` is not on it
# while `application/json` is — verified 2026-08-10 against production, where
# the JSON sibling came back `Content-Encoding: br` and these came back with no
# encoding at all.
#
# Serving them as text/plain puts them on the allowlist and costs nothing:
# csv-loader.ts reads every response with `.text()` and never inspects the
# content type (nor do the choreo-card and retro-lab fetches). Listed
# explicitly rather than as a `*.csv` glob because the directory also holds
# SVGs and this is a production header change.
/data/pictographs/DiamondPictographDataframe.csv
  Content-Type: text/plain; charset=utf-8

/data/pictographs/BoxPictographDataframe.csv
  Content-Type: text/plain; charset=utf-8

/data/pictographs/SkewedPictographDataframe.csv
  Content-Type: text/plain; charset=utf-8

/data/pictographs/TrigridPictographDataframe.csv
  Content-Type: text/plain; charset=utf-8

# These filenames include the source post ID. Changing the media means changing
# the URL, so browsers can keep the old bytes without revalidating every visit.
/assets/landing/hero-video-DAME3bEvN3N.mp4
  Cache-Control: public, max-age=31536000, immutable

/images/landing/hero-poster-DAME3bEvN3N.webp
  Cache-Control: public, max-age=31536000, immutable
