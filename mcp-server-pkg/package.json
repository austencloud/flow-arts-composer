{
  "name": "@austencloud/tka-domain-mcp",
  "version": "2.5.0",
  "description": "MCP server for The Kinetic Alphabet domain - pictograph rendering, sequence generation, and educational tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tka-domain-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "data/",
    "assets/",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/sync-card-assets.mjs",
    "build": "npm run prepare:assets && node build.mjs",
    "test": "npm run build && vitest run",
    "test:pack": "node scripts/verify-packed-package.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tka/domain": "file:../packages/domain",
    "@tka/render-composition": "file:../packages/render-composition",
    "@tka/render-core": "file:../packages/render-core",
    "@tka/sequence-engine": "file:../packages/sequence-engine",
    "@tka/tka-types": "file:../packages/tka-types",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "mcp",
    "tka",
    "kinetic-alphabet",
    "flow-arts",
    "pictograph"
  ],
  "author": "austencloud",
  "license": "Elastic-2.0"
}
