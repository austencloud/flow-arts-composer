# =============================================================================
# Flow Arts Composer - Environment Variables
# =============================================================================
# Copy this file to .env and fill in values for local development.
# Never commit .env to git.
#
# Variables prefixed PUBLIC_ are exposed to the browser.
# All others are server-only.
# =============================================================================


# =============================================================================
# REQUIRED TO RUN LOCALLY
# These must be present (even if blank) or the dev server will crash on startup.
# =============================================================================

# SvelteKit requires these PUBLIC_ vars to be declared at build time.
# Leave them blank to disable the features — the app handles missing values gracefully.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://rune.tkaflowarts.com
PUBLIC_POSTHOG_PROJECT_ID=
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_ENVIRONMENT=development
PUBLIC_APP_NAME=Flow Arts Composer

# Firebase config is hardcoded in src/lib/shared/auth/firebase.ts, so no
# Firebase keys are needed here for the browser app to connect.


# =============================================================================
# OPTIONAL - Features degrade gracefully when these are missing
# =============================================================================

# --- TIKA AI Chat (server-side) ---
# At least one key needed for the TIKA assistant to respond.
# Anthropic Claude is the primary model; DeepSeek is the fallback.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- PostHog Analytics (server-side admin routes only) ---
# The replay player also needs session_recording:read plus
# sharing_configuration:read and sharing_configuration:write scopes.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=us.posthog.com
# Production build only (Cloudflare Pages), with VITE_SOURCEMAP=true: a key with
# error_tracking:write and organization:read that uploads source maps.
POSTHOG_SOURCEMAP_API_KEY=

# --- SEO measurement warehouse ---
# Search Console's API property spelling is exact. Domain properties use the
# sc-domain: prefix. Google Application Default Credentials are used unless an
# inline service account or GOOGLE_APPLICATION_CREDENTIALS is supplied.
GSC_PROPERTY=sc-domain:tkaflowarts.com
GSC_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=the-kinetic-alphabet
GSC_EXPORT_DATASET=searchconsole_tkaflowarts
SEO_MEASUREMENT_DATASET=seo_measurement
SEO_PERFORMANCE_SOURCE=api

# Fill these with the real production dates. A scorecard cannot declare a win
# until the deployment and indexing dates are registered.
SEO_DEPLOYMENT_DATE=
SEO_INDEXED_DATE=
SEO_INSTRUMENTATION_START_DATE=

# --- Step-up Authentication ---
# Signing secret for elevated-privilege cookie sessions.
# Generate with: openssl rand -base64 32
# Without this, step-up auth prompts won't work but normal sign-in is unaffected.
STEP_UP_COOKIE_SECRET=


# =============================================================================
# FIREBASE ADMIN (scripts and server-side admin API routes)
# Not needed to run the app. Only needed for admin scripts in scripts/ and
# server routes that call Firebase Admin SDK (e.g. requireAdmin endpoints).
# =============================================================================

# Option A: Inline JSON of the service account key (useful in CI/CD)
# Uncomment and fill in the JSON string if you prefer this method. Make sure to escape quotes properly.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option B: Place serviceAccountKey.json in the project root.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key


# =============================================================================
# AGENT FEEDBACK INGEST
# Shared secret for URL-based feedback submission from LLM agents.
# Generate with: openssl rand -hex 32
# =============================================================================
FEEDBACK_INGEST_KEY=

# Native app availability (flip PUBLIC_APP_LAUNCHED=1 at store launch)
PUBLIC_APP_LAUNCHED=
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
