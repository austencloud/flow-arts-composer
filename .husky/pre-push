#!/usr/bin/env sh
# NOT ACTIVE — see the header of .husky/pre-commit. `core.hooksPath` is unset, so
# git runs `.git/hooks/pre-push` instead. That copy carries the LFS hook and the
# Codex-mirror check; the unit-test gate below is NOT in it and has never run on
# a push. Verified 2026-08-16.
. "$(dirname -- "$0")/_/husky.sh"

# Block non-admin pushes to main
BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ]; then
  # Check TKA credentials for role
  CREDS_FILE="$HOME/.tka/credentials.json"

  if [ ! -f "$CREDS_FILE" ]; then
    echo ""
    echo "  ❌ Cannot push to main — not authenticated."
    echo "  Run: node scripts/fetch-feedback.js login"
    echo ""
    exit 1
  fi

  # Check if this is the admin (Austen) by UID
  ADMIN_UID="PBp3GSBO6igCKPwJyLZNmVEmamI3"
  USER_UID=$(node -e "try{console.log(JSON.parse(require('fs').readFileSync('$CREDS_FILE','utf8')).uid)}catch{}" 2>/dev/null)

  if [ "$USER_UID" != "$ADMIN_UID" ]; then
    USER_NAME=$(node -e "try{console.log(JSON.parse(require('fs').readFileSync('$CREDS_FILE','utf8')).displayName||'unknown')}catch{}" 2>/dev/null)
    echo ""
    echo "  ❌ Contributors cannot push directly to main."
    echo ""
    echo "  Hey $USER_NAME — create a feature branch instead:"
    echo ""
    echo "    git checkout -b fb/<feedback-id>-short-description"
    echo "    git push -u origin fb/<feedback-id>-short-description"
    echo ""
    echo "  Then open a PR for review. Austen will merge it."
    echo ""
    exit 1
  fi
fi

# Regenerating the Codex mirror is mechanical, not a judgment call, and it has
# twice gone red on main purely because someone edited .claude/skills|agents and
# didn't rerun it. A red main skips Deploy Pages (gated), so this trivial drift
# freezes production. 0.12s here beats a stranded deploy.
echo "🔍 Checking Codex skill mirror..."
if ! node scripts/sync-codex-skills.mjs --check; then
  echo ""
  echo "  ❌ Codex mirror is out of date — this would go red on main and"
  echo "     silently block the production deploy."
  echo "  Run: pnpm skills:sync   (then stage the regenerated .codex/ files)"
  echo ""
  exit 1
fi
echo "✅ Codex mirror in sync"

# Run unit tests before push
echo "🧪 Running unit tests..."
npx vitest run --config tests/config/vitest.config.ts 2>/dev/null
if [ $? -ne 0 ]; then
  echo ""
  echo "  ❌ Unit tests failed. Fix failures before pushing."
  echo "  Run: npm test"
  echo ""
  exit 1
fi
echo "✅ Unit tests passed"

# Local opt-in: keep Android device builds off contributor machines that do not
# have the SDK. This also works when Husky is the active hooks path.
# The script prints its own "[native] ..." outcome line and exits 2 when it
# stopped before building anything (another push's build holds the lock, low
# memory, no JDK) or 1 when a build or install step broke. Neither blocks the
# push. Husky re-runs this file with `sh -e`, so the status is read with `||`.
if [ "$(git config --bool --get tka.pushDeployAndroid 2>/dev/null)" = "true" ]; then
  native_status=0
  node scripts/native-push-deploy.mjs "$@" || native_status=$?
  if [ "$native_status" -eq 2 ]; then
    echo "[native] Android build skipped before it started; the [native] line above says why. Git push will continue."
  elif [ "$native_status" -ne 0 ]; then
    echo "[native] Android build or install failed; the [native] line above says where. Git push will continue."
  fi
fi
