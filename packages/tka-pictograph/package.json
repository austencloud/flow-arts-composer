{
  "name": "@austencloud/tka-pictograph",
  "version": "0.1.1",
  "description": "Draws The Kinetic Alphabet's pictographs as SVG, in Node or a browser, from Austen Cloud's own renderer and art.",
  "license": "Elastic-2.0",
  "author": "Austen Cloud",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE"
  ],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "build": "node scripts/sync-assets.mjs && node build.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
