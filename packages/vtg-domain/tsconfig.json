{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "paths": {
      "@flow-arts/core": ["../flow-arts-core/dist/index.d.ts"]
    }
  },
  "references": [{ "path": "../flow-arts-core" }],
  "include": ["src/**/*.ts"]
}
