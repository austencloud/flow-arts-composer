{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/routes/**/*.svelte",
    "src/routes/**/*.ts",
    "src/lib/shared/modules/ModuleRenderer.svelte",
    "src/lib/features/**/*Module.svelte",
    "src/lib/features/**/*Tab.svelte",
    "src/lib/features/admin/components/AdminDashboard.svelte",
    "src/lib/features/background-builder/BackgroundBuilder.svelte",
    "src/lib/features/community/Community.svelte",
    "src/lib/shared/di/index.ts",
    "src/lib/shared/di/containers/*.ts",
    "scripts/*.js",
    "scripts/*.cjs",
    "scripts/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/config/*.ts",
    "firebase-functions/src/index.ts",
    "vite.config.ts",
    "src/config/svelte-options.js"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "scripts/**/*.{js,cjs,ts}",
    "tests/**/*.ts"
  ],
  "ignore": [
    "**/*.d.ts",
    "src/stories/**",
    "docs/**",
    "**/node_modules/**",
    "scripts/temp/**"
  ],
  "ignoreDependencies": [
    "@sveltejs/adapter-*"
  ]
}
