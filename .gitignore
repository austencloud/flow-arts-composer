# Build and deployment artifacts
# 🚨 CRITICAL: Use /build NOT **/build/** or build/
# The leading slash (/) ensures we only ignore the root-level build output directory,
# NOT source code directories like src/lib/modules/build/ which contain components!
# Without the leading slash, git would ignore ALL directories named "build" at any depth.
/build                          # Ignore ONLY root-level build directory (SvelteKit output)
/build/**
/.stable-preview*
# App-level build directories (landing, etc.)
apps/*/build/**
# Netlify (no longer used)
.netlify/
# Cloudflare Wrangler local dev files
.wrangler/
dist/
/dev-dist/                      # Vite PWA dev mode output
.output/
/_app/

# Environment files
.env
.env.local
.env.production.local
.env.*.local

