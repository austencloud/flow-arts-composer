+  mixer.stopAllAction();
+  mixer.uncacheClip(clip);
+
+  const baked = new Set(values.keys());
+  baked.add(hipsName);
+  const tracks = clip.tracks.filter((track) => !baked.has(track.name));
+  for (const [name, array] of values)
+    tracks.push(new QuaternionKeyframeTrack(name, times, array));
+  tracks.push(new VectorKeyframeTrack(hipsName, times, hipsValues));
