+  return new AnimationClip(clip.name, clip.duration, tracks, clip.blendMode);
+}
+
+const measuredLeftHip = new Vector3();
+const measuredRightHip = new Vector3();
+const measuredLeftFoot = new Vector3();
+const measuredRightFoot = new Vector3();
+const measuredRightAxis = new Vector3();
+const measuredFootDelta = new Vector3();
+
+/**
+ * Work out the least symmetric foot shift that keeps a pose out of the
+ * opposite leg's lane. Exported so this safety gate can be proven without
+ * loading a renderer or relying on a screenshot.
+ */
+export function requiredLegOrderShift(
+  leftHip: Vector3,
+  rightHip: Vector3,
+  leftFoot: Vector3,
+  rightFoot: Vector3,
+  minimumShare: number
+): number {
+  measuredRightAxis.subVectors(rightHip, leftHip);
+  measuredRightAxis.y = 0;
+  const hipSpan = measuredRightAxis.length();
+  if (hipSpan < 1e-6) return 0;
+  measuredRightAxis.multiplyScalar(1 / hipSpan);
+  const margin = measuredRightAxis.dot(
+    measuredFootDelta.subVectors(rightFoot, leftFoot)
+  );
+  return Math.max(0, (hipSpan * minimumShare - margin) * 0.5);
+}
+
+/** Measure first, then solve. That makes the constraint non-causal and cyclic. */
+function measureLegClearance(
+  clip: AnimationClip,
+  footprint: ClipFootprint,
+  root: Object3D,
+  rig: Rig,
+  sides: Side[],
+  minimumShare: number
+): Float32Array {
+  const samples = footprint.samples;
+  const step = clip.duration / (samples - 1);
+  const curve = new Float32Array(samples);
+  const mixer = new AnimationMixer(root);
+  mixer.clipAction(clip).play();
+  const toLocal = new Matrix4();
+
+  for (let i = 0; i < samples; i++) {
+    poseSample(mixer, i * step, i, rig, sides, footprint.hips[i]!);
+    toLocal.copy(rig.frame.matrixWorld).invert();
+    rig.left.chain.root
+      .getWorldPosition(measuredLeftHip)
+      .applyMatrix4(toLocal);
+    rig.right.chain.root
+      .getWorldPosition(measuredRightHip)
+      .applyMatrix4(toLocal);
+    read(
+      measuredLeftFoot,
+      sides[0]!.track.ankle,
+      i,
+      measuredLeftHip,
+      rig.legLength
+    );
+    read(
+      measuredRightFoot,
+      sides[1]!.track.ankle,
+      i,
+      measuredRightHip,
+      rig.legLength
+    );
+    curve[i] = requiredLegOrderShift(
+      measuredLeftHip,
+      measuredRightHip,
+      measuredLeftFoot,
+      measuredRightFoot,
+      minimumShare
+    );
+  }
+
+  mixer.stopAllAction();
+  mixer.uncacheClip(clip);
+  smoothCircular(curve, CLEARANCE_ROUNDS);
+  return curve;
+}
+
+function poseSample(
+  mixer: AnimationMixer,
+  time: number,
+  index: number,
+  rig: Rig,
+  sides: Side[],
+  hipsHeight: number
+): void {
+  rig.hips.position.set(0, 0, 0);
+  mixer.setTime(time);
+  rig.hips.position.add(rig.hipsRest);
+  rig.hips.position.y = rig.floor + hipsHeight * rig.legLength;
+  rig.frame.updateMatrixWorld(true);
+  alignPelvis(rig, sides, index);
+  rootUpdate(rig);
+}
+
+function rootUpdate(rig: Rig): void {
+  let root: Object3D = rig.frame;
+  while (root.parent) root = root.parent;
+  root.updateMatrixWorld(true);
+}
+
+function readBodyRight(into: Vector3, rig: Rig, toLocal: Matrix4): void {
+  rig.left.chain.root.getWorldPosition(measuredLeftHip).applyMatrix4(toLocal);
+  rig.right.chain.root.getWorldPosition(measuredRightHip).applyMatrix4(toLocal);
