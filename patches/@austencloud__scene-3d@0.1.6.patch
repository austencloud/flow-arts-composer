+/** The grip ring — the opening the hand passes through. */
+const HOLE_PIVOT: Contour = {
+  start: [0.03125, 0.04747],
+  curves: [
+    [0.02769, 0.04391, 0.02334, 0.04074, 0.01741, 0.03797],
