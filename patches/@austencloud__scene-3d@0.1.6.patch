index 0000000000000000000000000000000000000000..e2e21cf354a4c90c5e5e9c84eedec1b83f00276a
--- /dev/null
+++ b/src/lib/state/prop-finish-state.svelte.ts
@@ -0,0 +1,126 @@
+/**
+ * Prop Finish State
+ *
+ * Some props exist in two real builds: the fire one you burn and the day one
+ * you practise with. A triad is steel spines and kevlar wicks, or a printed hub
+ * and glow heads. Same prop, same reach, same notation — different object.
+ *
+ * That is a display preference, not a notation change. This state supplies the
+ * scene default; a performer can override any part of the build independently.
+ */
+
+import { PropType } from "../domain/enums/PropType";
+
+export type PropFinish = "fire" | "day";
+export type FanBuild =
+  | "pictograph"
+  | "fire"
+  | "lotus"
+  | "day"
+  | "moon"
+  | "flat-grip"
+  | "star";
+export type FanFrameColor = "black" | "white";
+export type FanCover = "bare" | "covered";
+export type TriangleGrip = "corner" | "side";
+
+export interface PropBuild {
+  finish: PropFinish;
+  fanBuild: FanBuild;
+  fanFrameColor: FanFrameColor;
+  fanCover: FanCover;
+  /** Where the hand holds the triangle: a printed elbow or a side's bow point. */
+  triangleGrip: TriangleGrip;
+}
+
+class PropFinishState {
+  private _finish = $state<PropFinish>("fire");
+  private _fanBuild = $state<FanBuild>("pictograph");
+  private _fanFrameColor = $state<FanFrameColor>("black");
+  private _fanCover = $state<FanCover>("bare");
+  private _triangleGrip = $state<TriangleGrip>("corner");
+
+  get finish(): PropFinish {
+    return this._finish;
+  }
+
+  set(finish: PropFinish): void {
+    this._finish = finish;
+  }
+
+  toggle(): void {
+    this._finish = this._finish === "fire" ? "day" : "fire";
+  }
+
+  get fanBuild(): FanBuild {
+    return this._fanBuild;
+  }
+
+  setFanBuild(build: FanBuild): void {
+    this._fanBuild = build;
+  }
+
+  get fanFrameColor(): FanFrameColor {
+    return this._fanFrameColor;
+  }
+
+  setFanFrameColor(color: FanFrameColor): void {
+    this._fanFrameColor = color;
+  }
+
+  get fanCover(): FanCover {
+    return this._fanCover;
+  }
+
+  get build(): PropBuild {
+    return {
+      finish: this._finish,
+      fanBuild: this._fanBuild,
+      fanFrameColor: this._fanFrameColor,
+      fanCover: this._fanCover,
+      triangleGrip: this._triangleGrip,
+    };
+  }
+
+  setFanCover(cover: FanCover): void {
+    this._fanCover = cover;
+  }
+
+  get triangleGrip(): TriangleGrip {
+    return this._triangleGrip;
+  }
+
+  setTriangleGrip(grip: TriangleGrip): void {
+    this._triangleGrip = grip;
+  }
+}
+
+export const propFinishState = new PropFinishState();
+
+/**
+ * The props Prop3D actually builds twice. Everything else ignores the finish,
+ * so a Fire/Day control shown next to them is a switch wired to nothing --
+ * surfaces ask this before offering the choice.
+ *
+ * A fire double staff and an LED baton are NOT on this list: those are separate
+ * objects with their own reach and their own notation entry, not two builds of
+ * one prop.
+ */
+const PROPS_WITH_FINISH_VARIANTS: ReadonlySet<PropType> = new Set([
+	PropType.TRIAD,
+	PropType.BIGTRIAD,
+	PropType.QUIAD,
+]);
+
+export function propHasFinishVariants(propType: PropType): boolean {
+	return PROPS_WITH_FINISH_VARIANTS.has(propType);
+}
+
+const PROPS_WITH_FAN_APPEARANCE: ReadonlySet<PropType> = new Set([
+	PropType.FAN,
+	PropType.BIGFAN,
+]);
+
+export function propHasFanAppearanceOptions(propType: PropType): boolean {
+	return PROPS_WITH_FAN_APPEARANCE.has(propType);
+}
