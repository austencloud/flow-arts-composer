@@ -0,0 +1,81 @@
+// A nearly open finger describes a very large circle whose center is not a
+// useful handle socket. Fade from the neutral-palm fallback as the measured
+// curl tightens, then trust the fitted channel completely for a closed grip.
+const CHANNEL_ENGAGE_RADIUS_RATIO = 0.75;
+const CHANNEL_FULL_RADIUS_RATIO = 0.3;
+const MIN_CHANNEL_RADIUS_RATIO = 0.08;
+const MAX_CHANNEL_RADIUS_RATIO = 1.5;
+const MIN_CENTER_LONGITUDINAL_RATIO = 0.5;
+const MAX_CENTER_LONGITUDINAL_RATIO = 1.25;
+const MIN_CENTER_NORMAL_RATIO = -0.05;
+const MAX_CENTER_NORMAL_RATIO = 1.25;
+const MIN_DETERMINANT_RATIO = 1e-4;
+/**
+ * Fit the center of a cylindrical grip from the posed middle-finger chain.
+ *
+ * The three joint origins trace the finger's curl around the handle. Their
+ * circumcenter in the hand's longitudinal/palmar plane is therefore the
+ * shaft channel, while their average transverse coordinate keeps the socket
+ * centered on the same finger. The returned confidence fades an opening hand
+ * back to its neutral-palm fallback instead of letting an unstable, very
+ * large circumcircle throw the staff away from the hand.
+ */
+export function measureCylindricalGripChannel(proximal, middle, distal, longitudinal, palmNormal, transverse, fallback, out) {
+    const handLength = proximal.length();
+    if (!Number.isFinite(handLength) || handLength <= 1e-6) {
+        out.copy(fallback);
+        return 0;
+    }
+    const ax = proximal.dot(longitudinal);
+    const ay = proximal.dot(palmNormal);
+    const bx = middle.dot(longitudinal);
+    const by = middle.dot(palmNormal);
+    const cx = distal.dot(longitudinal);
+    const cy = distal.dot(palmNormal);
+    const determinant = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
+    if (!Number.isFinite(determinant) ||
+        Math.abs(determinant) < handLength * handLength * MIN_DETERMINANT_RATIO) {
+        out.copy(fallback);
+        return 0;
+    }
+    const aSquared = ax * ax + ay * ay;
+    const bSquared = bx * bx + by * by;
+    const cSquared = cx * cx + cy * cy;
+    const centerLongitudinal = (aSquared * (by - cy) +
+        bSquared * (cy - ay) +
+        cSquared * (ay - by)) /
+        determinant;
+    const centerNormal = (aSquared * (cx - bx) +
+        bSquared * (ax - cx) +
+        cSquared * (bx - ax)) /
+        determinant;
+    const radius = Math.hypot(centerLongitudinal - ax, centerNormal - ay);
+    const radiusRatio = radius / handLength;
+    const centerLongitudinalRatio = centerLongitudinal / handLength;
+    const centerNormalRatio = centerNormal / handLength;
+    if (!Number.isFinite(radiusRatio) ||
+        !Number.isFinite(centerLongitudinalRatio) ||
+        !Number.isFinite(centerNormalRatio) ||
+        radiusRatio < MIN_CHANNEL_RADIUS_RATIO ||
+        radiusRatio > MAX_CHANNEL_RADIUS_RATIO ||
+        centerLongitudinalRatio < MIN_CENTER_LONGITUDINAL_RATIO ||
+        centerLongitudinalRatio > MAX_CENTER_LONGITUDINAL_RATIO ||
+        centerNormalRatio < MIN_CENTER_NORMAL_RATIO ||
+        centerNormalRatio > MAX_CENTER_NORMAL_RATIO) {
+        out.copy(fallback);
+        return 0;
+    }
+    const transverseCenter = (proximal.dot(transverse) +
+        middle.dot(transverse) +
+        distal.dot(transverse)) /
+        3;
+    out
+        .copy(longitudinal)
+        .multiplyScalar(centerLongitudinal)
+        .addScaledVector(palmNormal, centerNormal)
+        .addScaledVector(transverse, transverseCenter);
+    const confidence = Math.max(0, Math.min(1, (CHANNEL_ENGAGE_RADIUS_RATIO - radiusRatio) /
+        (CHANNEL_ENGAGE_RADIUS_RATIO - CHANNEL_FULL_RADIUS_RATIO)));
+    out.lerp(fallback, 1 - confidence);
+    return confidence;
+}
