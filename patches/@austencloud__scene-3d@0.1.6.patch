+    }
+
+    const calibrateSide = (
+      hand: Bone,
+      fingers: Map<FingerBoneName, Bone>
+    ): {
+      axis: Vector3;
+      longitudinal: Vector3;
+      palm: Vector3;
+      palmNormal: Vector3;
+      worldPalmLength: number;
+    } | null => {
+      const index1 = fingers.get("Index1");
+      const pinky1 = fingers.get("Pinky1");
+      const middle1 = fingers.get("Middle1");
+      const thumb1 = fingers.get("Thumb1");
+      if (!index1 || !pinky1 || !middle1 || !thumb1) return null;
+      hand.updateWorldMatrix(true, false);
+      this._m1.copy(hand.matrixWorld).invert();
+      const i = index1.getWorldPosition(this._v1).applyMatrix4(this._m1);
+      const p = pinky1.getWorldPosition(this._v2).applyMatrix4(this._m1);
+      const handWorld = hand.getWorldPosition(new Vector3());
+      const middleWorld = middle1.getWorldPosition(new Vector3());
+      const m = middleWorld.clone().applyMatrix4(this._m1);
+      const thumb = thumb1
+        .getWorldPosition(new Vector3())
+        .applyMatrix4(this._m1);
+      const longitudinal = m.clone();
+      if (longitudinal.lengthSq() < 1e-10) return null;
+      longitudinal.normalize();
+      const transverse = new Vector3().subVectors(p, i);
+      transverse.addScaledVector(
+        longitudinal,
+        -transverse.dot(longitudinal)
+      );
+      if (transverse.lengthSq() < 1e-10) return null;
+      transverse.normalize();
+
+      const palmNormal = new Vector3()
+        .crossVectors(transverse, longitudinal)
+        .normalize();
+      if (palmNormal.dot(thumb.sub(m)) < 0) palmNormal.negate();
+
+      // Index -> pinky is directed toward the staff's pinky end (-Y). The
+      // opposite direction would silently flip which end the thumb faces.
+      const axis = transverse.clone();
+      const palm = m.clone().multiplyScalar(PALM_CENTER_FRACTION);
+      const worldPalmLength =
+        handWorld.distanceTo(middleWorld) * PALM_CENTER_FRACTION;
+      return { axis, longitudinal, palm, palmNormal, worldPalmLength };
+    };
+
+    const left = calibrateSide(leftChain.effector, chains.left);
+    const right = calibrateSide(rightChain.effector, chains.right);
+    if (left) {
+      this.leftGripAxisLocal = left.axis;
+      this.leftGripLongitudinalLocal = left.longitudinal;
+      this.leftPalmFallbackLocal = left.palm;
+      this.leftPalmLocal = left.palm.clone();
+      this.leftPalmNormalLocal = left.palmNormal;
+      this.leftPalmWorldLength = left.worldPalmLength;
+    }
+    if (right) {
+      this.rightGripAxisLocal = right.axis;
+      this.rightGripLongitudinalLocal = right.longitudinal;
+      this.rightPalmFallbackLocal = right.palm;
+      this.rightPalmLocal = right.palm.clone();
+      this.rightPalmNormalLocal = right.palmNormal;
+      this.rightPalmWorldLength = right.worldPalmLength;
+    }
+    this.gripCalibrated = true;
+  }
+
+  /**
+   * Move each active shaft socket into the opening described by the posed
+   * middle-finger chain. Measuring in hand-local space makes this independent
+   * of arm IK, avatar scale, and world orientation.
+   */
+  private updateGripChannels(state: SkeletonState, pose: BodyPose): void {
+    const chains = state.fingerChains;
+    if (!chains) return;
+
+    const updateSide = (
+      hand: Bone | undefined,
+      fingers: Map<FingerBoneName, Bone>,
+      longitudinal: Vector3 | null,
+      palmNormal: Vector3 | null,
+      transverse: Vector3 | null,
+      fallback: Vector3 | null,
+      channel: Vector3 | null,
+      active: boolean
+    ): number | null => {
+      if (
+        !hand ||
+        !longitudinal ||
+        !palmNormal ||
+        !transverse ||
+        !fallback ||
+        !channel
+      ) {
+        return null;
+      }
+      if (!active) {
+        channel.copy(fallback);
+      } else {
+        const middle1 = fingers.get("Middle1");
+        const middle2 = fingers.get("Middle2");
+        const middle3 = fingers.get("Middle3");
+        if (!middle1 || !middle2 || !middle3) {
+          channel.copy(fallback);
+        } else {
+          hand.updateWorldMatrix(true, true);
+          this._m1.copy(hand.matrixWorld).invert();
+          middle1
+            .getWorldPosition(this._gripProximalLocal)
+            .applyMatrix4(this._m1);
+          middle2
+            .getWorldPosition(this._gripMiddleLocal)
+            .applyMatrix4(this._m1);
+          middle3
+            .getWorldPosition(this._gripDistalLocal)
+            .applyMatrix4(this._m1);
+          measureCylindricalGripChannel(
+            this._gripProximalLocal,
+            this._gripMiddleLocal,
+            this._gripDistalLocal,
+            longitudinal,
+            palmNormal,
+            transverse,
+            fallback,
+            channel
+          );
+        }
+      }
+
+      hand.getWorldPosition(this._gripHandWorld);
+      this._gripChannelWorld.copy(channel);
+      hand.localToWorld(this._gripChannelWorld);
+      return this._gripHandWorld.distanceTo(this._gripChannelWorld);
+    };
+
+    const leftLength = updateSide(
+      this.skeleton.getLeftArmChain()?.effector,
+      chains.left,
+      this.leftGripLongitudinalLocal,
+      this.leftPalmNormalLocal,
+      this.leftGripAxisLocal,
+      this.leftPalmFallbackLocal,
+      this.leftPalmLocal,
+      pose.leftHand !== null
+    );
+    const rightLength = updateSide(
+      this.skeleton.getRightArmChain()?.effector,
+      chains.right,
+      this.rightGripLongitudinalLocal,
+      this.rightPalmNormalLocal,
+      this.rightGripAxisLocal,
+      this.rightPalmFallbackLocal,
+      this.rightPalmLocal,
+      pose.rightHand !== null
+    );
+    if (leftLength !== null) this.leftPalmWorldLength = leftLength;
+    if (rightLength !== null) this.rightPalmWorldLength = rightLength;
+  }
+
+  /**
+   * How fully the same-side hug is engaged, read from the stance yaw the
+   * planner asked for. 0 leaves every square pose on its historical approach.
+   */
+  private hugBlend(): number {
+    const yaw = Math.abs(this.stanceYawSmoothedRad);
+    const t = (yaw - HUG_YAW_KNEE) / (HUG_YAW_FULL - HUG_YAW_KNEE);
+    const c = Math.max(0, Math.min(1, t));
+    return c * c * (3 - 2 * c);
+  }
+
+  /**
+   * Direction the hand points, wrist to palm, for a requested grip.
+   *
+   * A square stance keeps the historical approach: straight along the medial
+   * axis, so the wrist sits a palm length outboard of the grip. Once the chest
+   * turns side-on the goal becomes medial, eased back toward the forearm by a
+   * bounded wrist deviation and resolved inside the plane the knuckle axis can
+   * actually reach. Nothing here moves the authored grip: the wrist travels
+   * around it on a palm-length sphere, so the hug is the hand rotating in, not
+   * a second placement pass, and the elbow stays where the arm already put it.
+   */
+  private computeHandDirection(
+    side: "left" | "right",
+    chain: BoneChain,
+    gripPoint: Vector3,
+    staffQuat: Quaternion | undefined,
+    out: Vector3
+  ): void {
+    const medialSign = side === "left" ? 1 : -1;
+    this._handMedial
+      .copy(this._bodyFrame.lateral)
+      .multiplyScalar(medialSign)
+      .normalize();
+    out.copy(this._handMedial);
+    const blend = this.hugBlend();
+    if (blend <= 1e-4 || !staffQuat) return;
+    // The knuckle axis is welded to the staff, so the only wrist-to-palm
+    // directions the orientation pass can actually reach lie in the plane
+    // perpendicular to the shaft. Solve the hug inside that plane; a goal
+    // outside it leaves the palm short of the grip by whatever the shaft
+    // swallows, which is how the first attempt pulled both staffs into the
+    // torso.
+    this._handAxis.set(0, -1, 0).applyQuaternion(staffQuat);
+    if (this._handAxis.lengthSq() <= 1e-10) return;
+    this._handAxis.normalize();
+    this._handMedial.addScaledVector(
+      this._handAxis,
+      -this._handMedial.dot(this._handAxis)
+    );
+    if (this._handMedial.lengthSq() <= 1e-10) return;
+    this._handMedial.normalize();
+    // Rotate the medial goal back toward the arm's own reach line by a
+    // bounded wrist deviation. Pure medial is the tightest hug the hand can
+    // hold; easing toward the arm's line is what keeps the elbow where it
+    // already is.
+    //
+    // Reference the SHOULDER, not the elbow. The elbow is where the previous
+    // frame's IK put it, so easing toward it closed the loop
+    // elbow -> wrist goal -> IK -> elbow, stepped once per frame. Where that
+    // loop's gain exceeds one it settles into an exact period-2 alternation:
+    // two hug poses that each reproduce the other, which is what made a
+    // frozen step flicker between a converged hug and a collapse. The
+    // shoulder is an input to this solve rather than an output of it, and the
+    // shoulder-to-grip chord is the same reach line the clearance solver
+    // already plans against, so the goal is stable by construction instead of
+    // by damping.
+    chain.root.getWorldPosition(this._handForearm);
+    this._handForearm.sub(gripPoint);
+    this._handForearm.addScaledVector(
+      this._handAxis,
+      -this._handForearm.dot(this._handAxis)
+    );
+    if (this._handForearm.lengthSq() <= 1e-10) return;
+    this._handForearm.normalize();
+    this._handDeviate
+      .copy(this._handForearm)
+      .addScaledVector(
+        this._handMedial,
+        -this._handForearm.dot(this._handMedial)
+      );
+    if (this._handDeviate.lengthSq() <= 1e-10) return;
+    this._handDeviate.normalize();
+    const toForearm = Math.acos(
+      Math.max(-1, Math.min(1, this._handMedial.dot(this._handForearm)))
+    );
+    const deviation = Math.min(HUG_WRIST_DEVIATION, toForearm);
+    this._handRef
+      .copy(this._handMedial)
+      .multiplyScalar(Math.cos(deviation))
+      .addScaledVector(this._handDeviate, Math.sin(deviation))
+      .normalize();
+    out.lerp(this._handRef, blend);
+    if (out.lengthSq() <= 1e-10) out.copy(this._handMedial);
+    else out.normalize();
+  }
+
+  private computeSocketTarget(
+    side: "left" | "right",
+    chain: BoneChain,
+    gripPoint: Vector3,
+    staffQuat: Quaternion | undefined
+  ): Vector3 {
+    const palmLocal = side === "left" ? this.leftPalmLocal : this.rightPalmLocal;
+    const worldPalmLength =
+      side === "left"
+        ? this.leftPalmWorldLength
+        : this.rightPalmWorldLength;
+    const out =
+      side === "left" ? this._socketTargetLeft : this._socketTargetRight;
+    if (side === "left") this.leftHandDirValid = false;
+    else this.rightHandDirValid = false;
+    if (!palmLocal || worldPalmLength <= 1e-6) return out.copy(gripPoint);
+    // Shift the IK target so the PALM, not the wrist joint, lands on the grip
+    // point. computeHandDirection owns which way the wrist sits off the grip;
+    // publish it so the orientation pass aims at the same goal.
+    const dir = side === "left" ? this.leftHandDir : this.rightHandDir;
+    this.computeHandDirection(side, chain, gripPoint, staffQuat, dir);
+    if (side === "left") this.leftHandDirValid = true;
+    else this.rightHandDirValid = true;
+    this._v1.copy(dir).multiplyScalar(worldPalmLength);
+    return out.copy(gripPoint).sub(this._v1);
+  }
+
+  /**
+   * Probe the IK solve; when the target is out of reach, protract the
+   * clavicle toward it (bounded) and record the residual deficit so the
+   * next frame's spine lean can make up the rest.
+   */
+  private applyReachEscalation(
+    side: "left" | "right",
+    chain: BoneChain,
+    target: IKTarget,
+    state: SkeletonState
+  ): void {
+    const probe = this.ikSolver.solve(chain, target);
+    const deficit = probe.success ? 0 : probe.error;
+
+    const clav = state.bones.get(
+      side === "left" ? "LeftShoulder" : "RightShoulder"
+    );
+    const extQuat =
+      side === "left" ? this.leftReachExtQuat : this.rightReachExtQuat;
+
+    let hasDesired = false;
+    if (clav && clav.parent && deficit > REACH_EPSILON) {
+      clav.getWorldPosition(this._v1);
+      this._v2.copy(chain.root.getWorldPosition(this._v2)).sub(this._v1);
+      this._v3.copy(target.position).sub(this._v1);
+      if (this._v2.lengthSq() > 1e-8 && this._v3.lengthSq() > 1e-8) {
+        this._v3.normalize();
+        this._q1.setFromUnitVectors(this._v2.normalize(), this._v3);
+        AvatarAnimator.clampQuatAngle(
+          this._q1,
+          MAX_REACH_EXT * Math.min(1, deficit / REACH_FULL_DEFICIT)
+        );
+        // World-frame swing -> clavicle-local delta by conjugation
+        clav.parent.getWorldQuaternion(this._q2);
+        this._q3
+          .copy(this._q2)
+          .invert()
+          .multiply(this._q1)
+          .multiply(this._q2);
+        hasDesired = true;
+        // Record the deficit direction for next frame's spine lean
+        this._frameLeanVec.addScaledVector(this._v3, deficit);
+      }
+    }
+
+    extQuat.slerp(hasDesired ? this._q3 : this._q4.identity(), this.smoothingFactor);
+
+    // Only premultiply when the raise block rebased the clavicle to
+    // (rest x raise) THIS frame - otherwise this would accumulate.
+    const clavRebased =
+      this._clavicleRaiseEnabled &&
+      this.clavicleRaiser !== null &&
+      this.shoulderRestCached;
+    if (clav && clavRebased) {
+      clav.quaternion.premultiply(extQuat);
+      clav.updateMatrixWorld(true);
+    }
+  }
+
+  private solveArmWithBodyClearance(
+    side: "left" | "right",
+    chain: BoneChain,
+    target: IKTarget,
+    context: ForearmFaceClearanceContext | null
+  ): void {
+    if (!context || !this.poleComputer || !target.poleHint) {
+      this.ikSolver.solveAndApply(chain, target);
+      return;
+    }
+
+    const requestedTarget = target.position.clone();
+    const reachDirection = requestedTarget
+      .clone()
+      .sub(context.shoulderPosition);
+    const requestedDistance = reachDirection.length();
+    if (requestedDistance < 1e-6) return;
+    reachDirection.normalize();
+
+    const cachedRatio =
+      side === "left"
+        ? this.leftClearanceReachRatio
+        : this.rightClearanceReachRatio;
+    const recoveryTick =
+      side === "left"
+        ? ++this.leftClearanceRecoveryTick
+        : ++this.rightClearanceRecoveryTick;
+
+    // Reuse the last measured-safe reach and pole on ordinary frames. Probe a
+    // slightly fuller reach periodically so the arm naturally recovers once
+    // the dangerous corridor has passed, without repeating a full circle
+    // search sixty times per second.
+    if (cachedRatio < 0.999) {
+      target.poleHint.copy(
+        side === "left"
+          ? this.leftClearancePoleVector
+          : this.rightClearancePoleVector
+      );
+      if (recoveryTick % ARM_CLEARANCE_RECOVERY_INTERVAL === 0) {
+        const recoveryRatio = Math.min(
+          1,
+          cachedRatio + ARM_CLEARANCE_RECOVERY_STEP
+        );
+        this.placeArmTargetAtRatio(
+          target,
+          context.shoulderPosition,
+          reachDirection,
+          requestedDistance,
+          chain.totalLength,
+          recoveryRatio
+        );
+        this.ikSolver.solveAndApply(chain, target);
+        if (this.armClearsBody(chain, context)) {
+          this.setClearanceReachRatio(side, recoveryRatio);
+          return;
+        }
+      }
+
+      this.placeArmTargetAtRatio(
+        target,
+        context.shoulderPosition,
+        reachDirection,
+        requestedDistance,
+        chain.totalLength,
+        cachedRatio
+      );
+      this.ikSolver.solveAndApply(chain, target);
+      if (this.armClearsBody(chain, context)) return;
+      target.position.copy(requestedTarget);
+    }
+
+    const preferredPole = target.poleHint.clone();
+    if (this.solveArmAtClearPole(chain, target, context)) {
+      this.rememberClearArmRoute(side, 1, target.poleHint);
+      return;
+    }
+
+    let previousDistance = requestedDistance;
+    for (const ratio of ARM_CLEARANCE_REACH_RATIOS) {
+      const retryDistance = Math.min(
+        requestedDistance,
+        chain.totalLength * ratio
+      );
+      if (retryDistance >= previousDistance - 1e-5) continue;
+      previousDistance = retryDistance;
+
+      target.position
+        .copy(context.shoulderPosition)
+        .addScaledVector(reachDirection, retryDistance);
+      target.poleHint.copy(
+        this.poleComputer.resolveForearmFaceClearance(
+          preferredPole,
+          target.position,
+          side,
+          context
+        )
+      );
+      if (this.solveArmAtClearPole(chain, target, context)) {
+        this.rememberClearArmRoute(side, ratio, target.poleHint);
+        return;
+      }
+    }
+
+    // No perfect route exists for this fixed grip. Preserve the best measured
+    // final candidate and cache the bounded reach so subsequent frames stay
+    // interactive while the audit continues to report the unsatisfied case.
+    this.rememberClearArmRoute(
+      side,
+      ARM_CLEARANCE_REACH_RATIOS[ARM_CLEARANCE_REACH_RATIOS.length - 1],
+      target.poleHint
+    );
+  }
+
+  private placeArmTargetAtRatio(
+    target: IKTarget,
+    shoulder: Vector3,
+    reachDirection: Vector3,
+    requestedDistance: number,
+    totalLength: number,
+    ratio: number
+  ): void {
+    target.position
+      .copy(shoulder)
+      .addScaledVector(
+        reachDirection,
+        Math.min(requestedDistance, totalLength * ratio)
+      );
+  }
+
+  private solveArmAtClearPole(
+    chain: BoneChain,
+    target: IKTarget,
+    context: ForearmFaceClearanceContext
+  ): boolean {
+    const preferredPole = target.poleHint!.clone().normalize();
+    const reachAxis = target.position
+      .clone()
+      .sub(context.shoulderPosition)
+      .normalize();
+    let bestMargin = -Infinity;
+    const bestPole = preferredPole.clone();
+    const candidatePole = new Vector3();
+
+    const testPole = (pole: Vector3): boolean => {
+      target.poleHint!.copy(pole);
+      this.ikSolver.solveAndApply(chain, target);
+      const margin = this.armBodyClearanceMargin(chain, context);
+      if (margin > bestMargin) {
+        bestMargin = margin;
+        bestPole.copy(pole);
+      }
+      return margin >= 0;
+    };
+
+    if (testPole(preferredPole)) return true;
+    for (let step = 1; step <= ARM_CLEARANCE_POLE_SEARCH_STEPS; step++) {
+      const angle = step * ARM_CLEARANCE_POLE_SEARCH_STEP;
+      candidatePole.copy(preferredPole).applyAxisAngle(reachAxis, angle);
+      if (testPole(candidatePole)) return true;
+      candidatePole.copy(preferredPole).applyAxisAngle(reachAxis, -angle);
+      if (testPole(candidatePole)) return true;
+    }
+
+    target.poleHint!.copy(bestPole);
+    this.ikSolver.solveAndApply(chain, target);
+    return false;
+  }
+
+  private rememberClearArmRoute(
+    side: "left" | "right",
+    ratio: number,
+    pole: Vector3
+  ): void {
+    this.setClearanceReachRatio(side, ratio);
+    (
+      side === "left"
+        ? this.leftClearancePoleVector
+        : this.rightClearancePoleVector
+    ).copy(pole);
+  }
+
+  private setClearanceReachRatio(
+    side: "left" | "right",
+    ratio: number
+  ): void {
+    if (side === "left") this.leftClearanceReachRatio = ratio;
+    else this.rightClearanceReachRatio = ratio;
+  }
+
+  private armClearsBody(
+    chain: BoneChain,
+    context: ForearmFaceClearanceContext
+  ): boolean {
+    return this.armBodyClearanceMargin(chain, context) >= 0;
+  }
+
+  private armBodyClearanceMargin(
+    chain: BoneChain,
+    context: ForearmFaceClearanceContext
+  ): number {
+    chain.root.getWorldPosition(this._v1);
+    chain.middle.getWorldPosition(this._v2);
+    chain.effector.getWorldPosition(this._v3);
+    this._v4.lerpVectors(
+      this._v1,
+      this._v2,
+      UPPER_ARM_SHOULDER_EXCLUSION
+    );
+
+    const faceClearance = context.minimumClearance ?? FOREARM_FACE_CLEARANCE;
+    let minimumMargin =
+      this.bodySegmentDistance(context.faceCenter, this._v2, this._v3) -
+      faceClearance;
+
+    const segments = [
+      [this._v4, this._v2],
+      [this._v2, this._v3],
+    ] as const;
+    for (const [start, end] of segments) {
+      if (context.neckCenter) {
+        minimumMargin = Math.min(
+          minimumMargin,
+          this.bodySegmentDistance(context.neckCenter, start, end) -
+            FOREARM_NECK_CLEARANCE
+        );
+      }
+      for (const torsoCenter of context.torsoCenters ?? []) {
+        minimumMargin = Math.min(
+          minimumMargin,
+          this.bodySegmentDistance(torsoCenter, start, end) -
+            FOREARM_TORSO_CLEARANCE
+        );
+      }
+    }
+    return minimumMargin;
+  }
+
+  private bodySegmentDistance(
+    point: Vector3,
+    start: Vector3,
+    end: Vector3
+  ): number {
+    return pointToSegmentDistance(
+      point,
+      start,
+      end,
+      this._segmentOffsetScratch,
+      this._segmentDirectionScratch,
+      this._segmentClosestScratch
+    );
+  }
+
+  /**
+   * Rotate the hand so its transverse knuckle axis lies along the staff axis,
+   * the wrist orientation goal. The remaining roll about the staff is resolved
+   * so each palm approaches from the medial side and leaves its wrist on
+   * the outside of its own staff. The result is clamped to anatomical range
+   * and THUMB-LOCKED: the staff ends are NOT
+   * interchangeable. The transverse index-to-pinky axis tracks the staff's
+   * pinky end (-Y) as a directed constraint, so the hand can
+   * never take the flipped solution - a real grip cannot swap which end
+   * the thumb faces without regrasping. Demand beyond the anatomical
+   * clamp reads as strain; absorbing it is the body's job (plane sweep,
+   * hand travel, stance yaw), not the wrist's.
+   */
+  private applyWristOrientation(
+    side: "left" | "right",
+    chain: BoneChain,
+    hand: HandPose,
+    ikWeight: number
+  ): void {
+    if (!this._wristOrientationEnabled) return;
+    const staffQuat = hand.wristRotation;
+    const gripAxis =
+      side === "left" ? this.leftGripAxisLocal : this.rightGripAxisLocal;
+    const palmLocal =
+      side === "left" ? this.leftPalmLocal : this.rightPalmLocal;
+    const palmNormalLocal =
+      side === "left" ? this.leftPalmNormalLocal : this.rightPalmNormalLocal;
+    const eff = chain.effector;
+    if (
+      !staffQuat ||
+      !gripAxis ||
+      !palmLocal ||
+      !palmNormalLocal ||
+      !eff.parent
+    )
+      return;
+
+    // Bone quaternions changed since the last matrix update - refresh so
+    // the grip frame reflects THIS frame's solve.
+    chain.root.updateMatrixWorld(true);
+
+    // Transverse index-to-pinky grip axis in world space
+    eff.getWorldQuaternion(this._q1);
+    this._v1.copy(gripAxis).applyQuaternion(this._q1);
+
+    // Staff PINKY end in world space (-Y; +Y is the thumb end / T-bar).
+    // Directed on purpose: no nearest-end negate, ever.
+    this._v2.set(0, -1, 0).applyQuaternion(staffQuat);
