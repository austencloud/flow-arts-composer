+} from "three";
+import type { BoneChain } from "../contracts/IAvatarSkeletonBuilder";
+import type { ClipFootprint, FootTrack } from "../clip-footprint";
+import { buildTwoBoneChain } from "../leg-geometry";
+import { HingeConstrainedLegIKSolver } from "./HingeConstrainedLegIKSolver";
+import {
+  KneeHingeAxisCalibrator,
+  kneeHingeReferenceAxis,
+} from "./KneeHingeAxisCalibrator";
+
+/** Rotation tracks this bake takes ownership of. Everything else is left alone. */
+const BAKED = [
+  "LeftUpLeg",
+  "LeftLeg",
+  "LeftFoot",
+  "RightUpLeg",
+  "RightLeg",
+  "RightFoot",
+] as const;
+
+/** A millimetre of shoe in the floor is not worth another solve. */
+const FLOOR_SETTLED = 0.001;
+/** Two passes settle it on every clip measured; the rest is a stop. */
+const FLOOR_PASSES = 4;
+/**
+ * How fast a foot lets go of the pitch the floor asked of it, in radians per
+ * second of clip time: a full turn a second, three degrees a sample at 120 Hz.
+ * The lift itself falls four to nine degrees a sample in the last samples
+ * before a toe leaves the floor on the shipped walk and run, so this is the
+ * slower of the two and the one the eye gets.
+ */
+const LIFT_RELEASE_RATE = 2 * Math.PI;
+/**
+ * Clip time solved ahead of the loop seam so a release in progress at the
+ * end of the cycle carries into its start. A quarter second lets go of ninety
+ * degrees; no measured lift is half that.
+ */
+const LIFT_PREROLL = 0.25;
+/**
+ * A short circular low-pass on a pose constraint. The footprint itself is
+ * sampled at 120 Hz, so eight passes round the boundary without dulling the
+ * authored swing.
+ */
+const CLEARANCE_ROUNDS = 8;
+
+export interface ContactRetargetOptions {
+  /**
+   * Minimum left-to-right ankle order as a share of hip-joint spacing.
+   *
+   * Lateral maneuvers use this to reject the retargeting failure where a
+   * narrow-hipped target turns a near-touching source pose into self-
+   * intersection. Forward locomotion leaves it unset because the sagittal
+   * foot pass is part of that gait.
+   */
+  minimumLegOrderShare?: number;
+  /** Extra cyclic smoothing for low-rate lateral source keys. */
+  footGoalSmoothingPasses?: number;
+}
+
+
+/**
+ * Put a clip's feet back where the animator put them.
+ *
+ * Retargeting a clip is done by copying rotation tracks across, and rotations
+ * carry pose rather than position. Two rigs holding identical joint angles put
+ * their feet in different places, because the places also depend on where the
+ * joints sit at rest - and these rigs disagree there by about six degrees at
+ * the hip and the ankle both. Six degrees at the hip is nine centimetres at
+ * the foot, which is the difference between a foot standing on the floor and a
+ * foot hovering beside where it should have stood.
+ *
+ * What that costs is measurable and large. On the source rig, walk-forward has
+ * each foot on the floor for 61% of the cycle with a quarter of the cycle on
+ * both feet at once, which is a walk. Copied onto an avatar, the same clip has
+ * a foot down 45% and 26% of the time, never both at once, and 29% of the
+ * cycle with neither foot down - which is a run, and a bad one. Everything
+ * downstream then works on a gait that was already broken: the plant hauls
+ * each foot an average of eight centimetres sideways to make a stance exist,
+ * and the ankle is wrenched to whatever angle that leaves.
+ *
+ * So the feet are solved rather than copied. The source clip's foot goals come
+ * in as `footprint`, in leg lengths from the hips and off the floor, and each
+ * sample is solved onto this rig's legs with the same IK the runtime plant
+ * uses. Contacts get the extra constraint that makes them contacts: the ball
+ * of the foot is held high enough that the front of the shoe rests on the
+ * floor rather than through it.
+ *
+ * The clip comes back with six rewritten rotation tracks, a pelvis height that
+ * belongs to this rig, and everything else untouched. `root` is posed during
+ * the bake and restored before returning.
+ */
+export function bakeContactPreservedLegs(
+  clip: AnimationClip,
+  footprint: ClipFootprint,
+  root: Object3D,
+  modelPrefix: string,
+  options: ContactRetargetOptions = {}
+): AnimationClip {
+  const rig = resolveRig(root, modelPrefix);
+  if (!rig) return clip;
+
+  const pose = capturePose(root);
+  try {
+    return solveClip(clip, footprint, root, modelPrefix, rig, options);
+  } finally {
+    restorePose(pose);
+    root.updateMatrixWorld(true);
+  }
+}
+
+interface Side {
+  chain: BoneChain;
+  toe: Object3D | null;
+  hinge: Vector3;
+  /** Flexion axis in the ankle's own space, positive dorsiflexing. */
+  ankleAxis: Vector3;
+  /** Dorsiflexion the floor asked of this foot on the last sample, radians. */
+  lift: number;
+  track: FootTrack;
+  /** Last trustworthy bend branch in this sequential clip bake. */
+  bendSign?: -1 | 1;
+}
+
+interface Rig {
+  hips: Bone;
+  hipsRest: Vector3;
+  /**
+   * The space the pelvis is posed in, which is where every goal is built.
+   *
+   * `hips.position` is written in it, so measuring the floor anywhere else
+   * would put the pelvis and the feet in two frames that only agree while the
+   * performer stands at the world origin facing north.
+   */
+  frame: Object3D;
+  /** In `frame`'s space, like every other length here. */
+  legLength: number;
+  floor: number;
+  left: Omit<Side, "track">;
+  right: Omit<Side, "track">;
+}
+
+/**
+ * Measure the rig the clip is being fitted to.
+ *
+ * Called with the rig at rest, which is where it is when clips are prepared -
+ * every number here is a bind-pose property, and reading them off a posed rig
+ * gives leg lengths that change as the character moves.
+ */
+function resolveRig(root: Object3D, prefix: string): Rig | null {
+  const bone = (name: string): Bone | null =>
+    (root.getObjectByName(`${prefix}${name}`) as Bone | undefined) ?? null;
+
+  const hips = bone("Hips");
+  if (!hips) return null;
+
+  root.updateMatrixWorld(true);
+  // Referenced to this rig's own hip line, so a rig authored facing some other
+  // way still calibrates. Both legs share one reference.
+  const leftHip = bone("LeftUpLeg");
+  const rightHip = bone("RightUpLeg");
+  const reference =
+    leftHip && rightHip
+      ? kneeHingeReferenceAxis(leftHip, rightHip)
+      : new Vector3(1, 0, 0);
+  const calibrator = new KneeHingeAxisCalibrator();
+  const build = (side: "Left" | "Right"): Omit<Side, "track"> | null => {
+    const upper = bone(`${side}UpLeg`);
+    const knee = bone(`${side}Leg`);
+    const ankle = bone(`${side}Foot`);
+    if (!upper || !knee || !ankle) return null;
+    const chain = buildTwoBoneChain(upper, knee, ankle);
+    const toe = bone(`${side}ToeBase`);
+    return {
+      chain,
+      toe,
+      hinge: calibrator.compute(chain, reference),
+      ankleAxis: ankleFlexionAxis(ankle, toe, reference),
+      lift: 0,
+    };
+  };
+
+  const left = build("Left");
+  const right = build("Right");
+  if (!left || !right) return null;
+  if (!(left.chain.totalLength > 0)) return null;
+
+  const frame = hips.parent ?? root;
+  return {
+    hips,
+    hipsRest: hips.position.clone(),
+    frame,
+    legLength: legLengthIn(frame, left.chain),
+    floor: restFloor(frame, left.toe, right.toe),
+    left,
+    right,
+  };
+}
+
+/**
+ * The axis the ankle flexes about, in the foot's own space, signed so that a
+ * positive rotation dorsiflexes: lifts the toes toward the shin.
+ *
+ * Taken from the character's hip line, like the knee hinge. A foot bone
+ * carries whatever axes its exporter chose, and the body is the one thing
+ * every rig's ankle agrees with. Read at rest, when the foot lies flat with
+ * its toes ahead, so the sign is settled by which way lifts them.
+ */
+function ankleFlexionAxis(
+  ankle: Object3D,
+  toe: Object3D | null,
+  referenceWorld: Vector3
+): Vector3 {
+  const axis = referenceWorld.clone().normalize();
+  if (toe) {
+    const reach = toe
+      .getWorldPosition(new Vector3())
+      .sub(ankle.getWorldPosition(new Vector3()));
+    if (new Vector3().crossVectors(axis, reach).y < 0) axis.negate();
+  }
+  return axis
+    .transformDirection(new Matrix4().copy(ankle.matrixWorld).invert())
+    .normalize();
+}
+
+/**
+ * How long the leg is in the pelvis's own space.
+ *
+ * Every height this bake writes is a number on the pelvis track or a point
+ * pushed through the pelvis's frame, and the footprint measures its distances
+ * in leg lengths, so the leg has to be measured in that same space.
+ * `buildTwoBoneChain` measures in world metres, which the solver wants and
+ * which is the same number only while the frame sits at unit scale. A rig
+ * authored at twice life size and normalised back down by a half-scale root
+ * reads a leg half as long as its own bones, so the pelvis gets rebuilt
+ * halfway to the floor and the knees fold under it to reach.
+ */
+function legLengthIn(frame: Object3D, chain: BoneChain): number {
+  const toLocal = new Matrix4().copy(frame.matrixWorld).invert();
+  const hip = chain.root.getWorldPosition(new Vector3()).applyMatrix4(toLocal);
+  const knee = chain.middle
+    .getWorldPosition(new Vector3())
+    .applyMatrix4(toLocal);
+  const ankle = chain.effector
+    .getWorldPosition(new Vector3())
+    .applyMatrix4(toLocal);
+  return hip.distanceTo(knee) + knee.distanceTo(ankle);
+}
+
+/**
+ * Where this rig's floor is, in its own space.
+ *
+ * Nominally zero, and close enough to it on every avatar measured - but a rig
+ * exported half a centimetre into the ground would otherwise have every stance
+ * in every clip baked half a centimetre into the ground with it.
+ */
+function restFloor(
+  frame: Object3D,
+  leftToe: Object3D | null,
+  rightToe: Object3D | null
+): number {
+  const toLocal = new Matrix4().copy(frame.matrixWorld).invert();
+  const point = new Vector3();
+  let lowest = Infinity;
+  for (const toe of [leftToe, rightToe]) {
+    if (!toe) continue;
+    for (const object of [toe, ...toe.children]) {
+      object.getWorldPosition(point).applyMatrix4(toLocal);
+      lowest = Math.min(lowest, point.y);
+    }
+  }
+  return Number.isFinite(lowest) ? lowest : 0;
+}
+
+function solveClip(
+  clip: AnimationClip,
+  footprint: ClipFootprint,
+  root: Object3D,
+  prefix: string,
+  rig: Rig,
+  options: ContactRetargetOptions
+): AnimationClip {
+  const samples = footprint.samples;
+  const step = clip.duration / (samples - 1);
+  const times = new Float32Array(samples);
+  const values = new Map<string, Float32Array>();
+  for (const name of BAKED)
+    values.set(`${prefix}${name}.quaternion`, new Float32Array(samples * 4));
+
+  const hipsName = `${prefix}Hips.position`;
+  const hipsValues = new Float32Array(samples * 3);
+
+  const solver = new HingeConstrainedLegIKSolver();
+  const mixer = new AnimationMixer(root);
+  mixer.clipAction(clip).play();
+
+  const smoothing = Math.max(0, options.footGoalSmoothingPasses ?? 0);
+  const sides: Side[] = [
+    { ...rig.left, track: smoothFootTrack(footprint.left, smoothing) },
+    { ...rig.right, track: smoothFootTrack(footprint.right, smoothing) },
+  ];
+  const clearance = options.minimumLegOrderShare
+    ? measureLegClearance(
+        clip,
+        footprint,
+        root,
+        rig,
+        sides,
+        options.minimumLegOrderShare
+      )
+    : null;
+  const toLocal = new Matrix4();
+  const toWorld = new Matrix4();
+  const pole = new Vector3();
+  const spin = new Quaternion();
+  const bodyRight = new Vector3();
+  const bakedBones = BAKED.map((name) => root.getObjectByName(`${prefix}${name}`));
+  const bakedValues = BAKED.map((name) => values.get(`${prefix}${name}.quaternion`)!);
+  const mixerPose = BAKED.map(() => new Quaternion());
+  const mixerHips = new Vector3();
+
+  // Sampled the way the runtime plays it: the pelvis zeroed, so a clip with
+  // no pelvis track leaves zero and a clip with one writes only its own
+  // motion, then the rig's height added under whichever it was.
+  rig.hips.position.set(0, 0, 0);
+
+  // Run up to the seam first. The lift release carries from each sample to
+  // the next and the clip loops, so sample zero has to inherit from the last
+  // samples the way every other sample inherits from the one before it. The
+  // run-up's writes are overwritten by the pass proper.
+  const preroll = Math.min(samples, Math.ceil(LIFT_PREROLL / step));
+  for (let n = -preroll; n < samples; n++) {
+    const i = n < 0 ? n + samples : n;
+    times[i] = i * step;
+
+    // The mixer writes a bone only when the clip's value changed since its
+    // last write, so what it wrote is kept and put back once the sample is
+    // recorded. A repeated value - the loop seam, which the run-up samples
+    // twice in a row - would otherwise leave the previous sample's solved legs
+    // and lowered pelvis in the solver's input.
+    mixer.setTime(i * step);
+    mixerHips.copy(rig.hips.position);
+    for (let b = 0; b < bakedBones.length; b++) {
+      const bone = bakedBones[b];
+      if (bone) mixerPose[b]!.copy(bone.quaternion);
+    }
+    const travelX = rig.hips.position.x;
+    const travelZ = rig.hips.position.z;
+    rig.hips.position.add(rig.hipsRest);
+    // Ride at the height the walk rides at rather than the height the rig
+    // stands at. Travel across the floor stays with the track that had it.
+    rig.hips.position.y = rig.floor + footprint.hips[i]! * rig.legLength;
+    root.updateMatrixWorld(true);
+    alignPelvis(rig, sides, i);
+    root.updateMatrixWorld(true);
+    hipsValues[i * 3] = travelX;
+    hipsValues[i * 3 + 1] = rig.hips.position.y - rig.hipsRest.y;
+    hipsValues[i * 3 + 2] = travelZ;
+
+    toWorld.copy(rig.frame.matrixWorld);
+    toLocal.copy(toWorld).invert();
+
+    // Bend the knees the way the performer faces. A world +Z pole bends the
+    // knee backwards for anyone facing south, and choreography sends them
+    // around the whole compass.
+    rig.hips.getWorldQuaternion(spin);
+    pole.set(0, 0, 1).applyQuaternion(spin);
+    pole.y = 0;
+    if (pole.lengthSq() < 1e-6) pole.set(0, 0, 1);
+    pole.normalize();
+
+    if (clearance) readBodyRight(bodyRight, rig, toLocal);
+    for (let sideIndex = 0; sideIndex < sides.length; sideIndex++)
+      solveSample(
+        solver,
+        sides[sideIndex]!,
+        i,
+        rig,
+        toLocal,
+        toWorld,
+        pole,
+        bodyRight,
+        clearance ? clearance[i]! * (sideIndex === 0 ? -1 : 1) : 0,
+        step
+      );
+
+    for (let b = 0; b < bakedBones.length; b++) {
+      const bone = bakedBones[b];
+      if (!bone) continue;
+      bone.quaternion.toArray(bakedValues[b]!, i * 4);
+      bone.quaternion.copy(mixerPose[b]!);
+    }
