diff --git a/dist/lib/services/bone-name-normalization.js b/dist/lib/services/bone-name-normalization.js
new file mode 100644
index 0000000000000000000000000000000000000000..1cf469d4a9529c870e130e7a7771a69058731f85
--- /dev/null
+++ b/dist/lib/services/bone-name-normalization.js
@@ -0,0 +1,37 @@
+/**
+ * One owner for exporter-namespace-tolerant bone name matching.
+ *
+ * Rigs authored in Maya/FBX tooling carry an export namespace on every joint:
+ * Mixamo writes `mixamorig:LeftHand` and, once a character has been
+ * re-uploaded, `mixamorig12:LeftHandThumb1`. Two things then happen to that
+ * name before a lookup sees it:
+ *
+ *   1. The character intake pipeline strips the namespace when it bakes a rig,
+ *      so rigs that went through intake arrive as bare `hand_l` / `thumb1_l`.
+ *   2. three.js sanitizes every node name at load time - `PropertyBinding`
+ *      deletes `[ ] . : /` outright - so a catalog GLB's
+ *      `mixamorig:LeftHandThumb1` reaches the runtime as
+ *      `mixamorigLeftHandThumb1`, colon and all structure gone.
+ *
+ * Both forms have to resolve against the same alias tables, or a rig whose
+ * joints merely carry a namespace looks exactly like a rig with no fingers.
+ *
+ * The Mixamo prefix is matched by name rather than by shape, because after
+ * sanitization there is no separator left to key on. Everything else is matched
+ * on the colon, which is only ever a namespace separator - it never appears
+ * inside a joint name in any convention this package supports (Mixamo
+ * `LeftHandThumb1`, characters3d.com `L_Thumb1`, Unreal `thumb1_l`).
+ */
+const MIXAMO_NAMESPACE = /^mixamorig\d*:?/;
+const EXPORT_NAMESPACE = /^[a-z0-9_]+:/;
+
+/**
+ * Lowercase a bone name and drop any exporter namespace prefix, so a rig's
+ * joints and this package's alias tables can be compared directly.
+ */
+export function normalizeBoneName(name) {
+    return name
+        .toLowerCase()
+        .replace(MIXAMO_NAMESPACE, "")
+        .replace(EXPORT_NAMESPACE, "");
+}
diff --git a/dist/lib/services/clip-footprint.js b/dist/lib/services/clip-footprint.js
new file mode 100644
index 0000000000000000000000000000000000000000..3e460c8c3eb4b80f91a49ee55d275edad40b3e3f
--- /dev/null
+++ b/dist/lib/services/clip-footprint.js
@@ -0,0 +1,261 @@
+import { AnimationMixer, Vector3, } from "three";
+/**
+ * Samples per second of clip.
+ *
+ * Twice the frame rate, because what a rig is asked to do between two of these
+ * is worked out by rotating each of three joints along its own shortest path,
+ * and three shortest paths compose into something that is not the path the
+ * foot took. On a long foot at toe-off the front of the shoe dips a couple of
+ * centimetres into the floor midway between two samples taken at sixty; at a
+ * hundred and twenty it is a few millimetres, for a few kilobytes a clip.
+ */
+const RATE = 120;
+/**
+ * Key rate of the clips this reads.
+ *
+ * Every locomotion clip in the pack carries thirty keys a second, checked on
+ * the leg tracks of all four.
+ */
+const SOURCE_RATE = 30;
+/**
+ * Rounding passes over each track.
+ *
+ * One pass is a weighted average of a sample and its neighbours, which spreads
+ * a corner across a span whose width grows as the square root of the count.
+ * Enough of them to reach half the gap between two source keys rounds the
+ * corner over about the span that produced it; past that the pass starts
+ * taking the stride down with it, and a walk measured at twenty passes has
+ * lost two centimetres of step.
+ */
+const ROUNDS = Math.round((2 * RATE * RATE) / (4 * SOURCE_RATE * SOURCE_RATE));
+/** Height above the floor that still counts as standing on it, in metres. */
+const GROUND = 0.025;
+/** Shorter than this is keyframe noise rather than a step, in samples. */
+const MIN_RUN = Math.round(RATE / 12);
+/** Gaps this short inside a stance are noise too. */
+const MAX_GAP = Math.round(RATE / 30);
+const footprints = new WeakMap();
+export function registerClipFootprint(clip, footprint) {
+    footprints.set(clip, footprint);
+}
+export function getClipFootprint(clip) {
+    return footprints.get(clip) ?? null;
+}
+export function trimLeadingHold(clip) {
+    let start = Infinity;
+    for (const track of clip.tracks) {
+        if (track.times.length > 0)
+            start = Math.min(start, track.times[0]);
+    }
+    if (!Number.isFinite(start) || start <= 1e-6)
+        return;
+    for (const track of clip.tracks) {
+        track.times = track.times.map((t) => Math.max(0, t - start));
+    }
+    clip.resetDuration();
+}
+/**
+ * Read a clip's foot contacts off the rig it was authored on.
+ *
+ * This has to happen while that rig is still in memory. Animation GLBs ship a
+ * whole character next to the clip and the loader drops it immediately, which
+ * is worth hundreds of megabytes across a cast - so the few kilobytes that say
+ * where the feet went are taken first, and the character still goes.
+ *
+ * The clip is played on `scene`, which is left posed at its last sample.
+ */
+export function extractClipFootprint(scene, clip) {
+    let prefix = null;
+    scene.traverse((object) => {
+        if (prefix === null && object.name.endsWith("Hips"))
+            prefix = object.name.slice(0, -4);
+    });
+    if (prefix === null)
+        return null;
+    const found = prefix;
+    const bone = (name) => scene.getObjectByName(`${found}${name}`) ??
+        scene.getObjectByName(name) ??
+        null;
+    const hips = bone("Hips");
+    const sides = {
+        left: {
+            upper: bone("LeftUpLeg"),
+            knee: bone("LeftLeg"),
+            ankle: bone("LeftFoot"),
+            toe: bone("LeftToeBase"),
+            tip: bone("LeftToe_End"),
+        },
+        right: {
+            upper: bone("RightUpLeg"),
+            knee: bone("RightLeg"),
+            ankle: bone("RightFoot"),
+            toe: bone("RightToeBase"),
+            tip: bone("RightToe_End"),
+        },
+    };
+    const { left, right } = sides;
+    if (!hips)
+        return null;
+    if (!left.upper || !left.knee || !left.ankle || !left.toe)
+        return null;
+    if (!right.upper || !right.knee || !right.ankle || !right.toe)
+        return null;
+    scene.updateMatrixWorld(true);
+    const legLength = distance(left.upper, left.knee) + distance(left.knee, left.ankle);
+    if (!(legLength > 0))
+        return null;
+    const samples = Math.max(2, Math.round(clip.duration * RATE) + 1);
+    const step = clip.duration / (samples - 1);
+    const mixer = new AnimationMixer(scene);
+    mixer.clipAction(clip).play();
+    const hipsAt = [];
+    const raw = {
+        left: emptySamples(),
+        right: emptySamples(),
+    };
+    for (let i = 0; i < samples; i++) {
+        mixer.setTime(i * step);
+        scene.updateMatrixWorld(true);
+        hipsAt.push(world(hips));
+        for (const key of ["left", "right"]) {
+            const joints = sides[key];
+            const toe = world(joints.toe);
+            raw[key].upper.push(world(joints.upper));
+            raw[key].ankle.push(world(joints.ankle));
+            raw[key].toe.push(toe);
+            raw[key].low.push(joints.tip ? Math.min(toe.y, world(joints.tip).y) : toe.y);
+        }
+    }
+    mixer.stopAllAction();
+    mixer.uncacheClip(clip);
+    // The floor is a low percentile rather than the lowest frame: one keyframe
+    // that dips through the ground would otherwise drag the whole plane down
+    // with it and lift every stance a centimetre clear of the floor.
+    const sorted = [...raw.left.low, ...raw.right.low].sort((a, b) => a - b);
+    const floor = sorted[Math.floor(sorted.length * 0.02)] ?? 0;
+    const hipsHeight = new Float32Array(samples);
+    for (let i = 0; i < samples; i++)
+        hipsHeight[i] = (hipsAt[i].y - floor) / legLength;
+    round(hipsHeight, 1);
+    return {
+        samples,
+        duration: clip.duration,
+        hips: hipsHeight,
+        left: buildTrack(raw.left, floor, legLength),
+        right: buildTrack(raw.right, floor, legLength),
+    };
+}
+function emptySamples() {
+    return { upper: [], ankle: [], toe: [], low: [] };
+}
+function buildTrack(raw, floor, legLength) {
+    const samples = raw.toe.length;
+    const ankle = new Float32Array(samples * 3);
+    const toe = new Float32Array(samples * 3);
+    const hip = new Float32Array(samples);
+    for (let i = 0; i < samples; i++) {
+        const origin = raw.upper[i];
+        write(ankle, i, raw.ankle[i], origin, legLength);
+        write(toe, i, raw.toe[i], origin, legLength);
+        hip[i] = (origin.y - floor) / legLength;
+    }
+    round(ankle, 3);
+    round(toe, 3);
+    round(hip, 1);
+    return { ankle, toe, hip, contact: detectContact(raw.low, floor) };
+}
+/**
+ * Round the corners a thirty-per-second clip leaves in the path.
+ *
+ * These clips carry thirty keys a second and are interpolated linearly, so a
+ * foot's path is a chain of straight segments with a corner at every key. The
+ * corner is where all the jerk in the walk lives: between keys the knee's
+ * acceleration is zero, and at each key it changes in a single frame.
+ *
+ * Resampling faster copies the corners exactly, so this rounds them - one
+ * weighted pass over neighbouring samples, which at a hundred and twenty a
+ * second spreads a corner over seventeen milliseconds. That is short enough to
+ * leave the shape of the step alone, and a foot standing still is a flat run of
+ * samples that averaging cannot move at all.
+ *
+ * The clip loops, so the ends are neighbours.
+ */
+function round(track, stride) {
+    const samples = track.length / stride;
+    if (samples < 3)
+        return;
+    // The last sample repeats the first, so the cycle is one shorter than it.
+    const cycle = samples - 1;
+    const source = new Float32Array(track.length);
+    for (let pass = 0; pass < ROUNDS; pass++) {
+        source.set(track);
+        for (let i = 0; i < samples; i++) {
+            const before = ((i - 1 + cycle) % cycle) * stride;
+            const after = ((i + 1) % cycle) * stride;
+            const here = i * stride;
+            for (let c = 0; c < stride; c++)
+                track[here + c] =
+                    0.25 * source[before + c] +
+                        0.5 * source[here + c] +
+                        0.25 * source[after + c];
+        }
+    }
+}
+function write(into, index, point, origin, legLength) {
+    into[index * 3] = (point.x - origin.x) / legLength;
+    into[index * 3 + 1] = (point.y - origin.y) / legLength;
+    into[index * 3 + 2] = (point.z - origin.z) / legLength;
+}
+/**
+ * Which samples have the foot on the floor.
+ *
+ * Height alone decides it. The obvious second test - that the foot is not
+ * travelling - cannot be applied to this set, because the four locomotion
+ * clips disagree about what travelling means: three carry the hips forward
+ * and leave the stance foot standing still in the world, while walk-backward
+ * was exported in place, so its stance foot slides half a metre backwards on
+ * purpose. A speed gate reads that clip as never touching the ground at all.
+ */
+function detectContact(low, floor) {
+    const samples = low.length;
+    const contact = new Uint8Array(samples);
+    for (let i = 0; i < samples; i++)
+        contact[i] = low[i] - floor <= GROUND ? 1 : 0;
+    for (let i = 0; i < samples; i++) {
+        if (contact[i])
+            continue;
+        let end = i;
+        while (end < samples && !contact[end])
+            end++;
+        if (end - i <= MAX_GAP && i > 0 && end < samples)
+            contact.fill(1, i, end);
+        i = end - 1;
+    }
+    for (let i = 0; i < samples; i++) {
+        if (!contact[i])
+            continue;
+        let end = i;
+        while (end < samples && contact[end])
+            end++;
+        // The first and last sample are the same instant of a looping clip, so a
+        // stance running off one end and back in the other is a single stance.
+        const spansSeam = (i === 0 && !!contact[samples - 1]) || end === samples;
+        let lowest = Infinity;
+        for (let f = i; f < end; f++)
+            lowest = Math.min(lowest, low[f]);
+        // A swing foot that skims low is not a stance, however long it skims for.
+        const touches = lowest - floor <= GROUND / 2;
+        if (!touches || (end - i < MIN_RUN && !spansSeam))
+            contact.fill(0, i, end);
+        i = end - 1;
+    }
+    return contact;
+}
+const scratch = new Vector3();
+function world(object) {
+    return object.getWorldPosition(new Vector3());
+}
+function distance(a, b) {
+    a.getWorldPosition(scratch);
+    return scratch.distanceTo(b.getWorldPosition(new Vector3()));
+}
