+
+/**
+ * Rotate the foot about `axis`, given in the floor's frame, by `theta`.
+ * Worked out where the floor is flat, so it is carried back through that
+ * frame's own rotation before it reaches the bone.
+ */
+function dorsiflex(foot: Object3D, axis: Vector3, theta: number): void {
