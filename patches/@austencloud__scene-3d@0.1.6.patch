diff --git a/src/lib/rendering/create-staff-object.ts b/src/lib/rendering/create-staff-object.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ecfaca907a475b4d454e2352e63601da4dfa3a97
--- /dev/null
+++ b/src/lib/rendering/create-staff-object.ts
@@ -0,0 +1,181 @@
+import {
+  CylinderGeometry,
+  Euler,
+  Group,
+  Mesh,
+  MeshBasicMaterial,
+  MeshStandardMaterial,
+  Quaternion,
+  SphereGeometry,
+  TorusGeometry,
+} from "three";
+import type { PropState3D } from "../domain/models/PropState3D";
+
+interface StaffGeometrySet {
+  shaft: CylinderGeometry;
+  tBar: CylinderGeometry;
+  tBarCap: SphereGeometry;
+  endCap: SphereGeometry;
+  grip: TorusGeometry;
+}
+
+interface StaffMaterialSet {
+  main: MeshStandardMaterial;
+  dark: MeshStandardMaterial;
+  grip: MeshStandardMaterial;
+  trail: MeshBasicMaterial;
+}
+
+export interface StaffObjectOptions {
+  color: "blue" | "red";
+  length: number;
+  thickness: number;
+  layer?: number;
+}
+
+export interface StaffObject {
+  root: Group;
+  setState(state: Pick<PropState3D, "worldRotation">): void;
+  dispose(): void;
+}
+
+const geometrySets = new Map<string, StaffGeometrySet>();
+const materialSets = new Map<"blue" | "red", StaffMaterialSet>();
+const trailGeometry = new SphereGeometry(0.015, 8, 8);
+const HORIZONTAL_QUAT = new Quaternion().setFromEuler(
+  new Euler(0, 0, Math.PI / 2),
+);
+
+function getStaffGeometrySet(
+  length: number,
+  thickness: number,
+): StaffGeometrySet {
+  const key = `${length}:${thickness}`;
+  const cached = geometrySets.get(key);
+  if (cached) return cached;
+
+  const tBarLength = length * 0.228;
+  const geometry = {
+    shaft: new CylinderGeometry(thickness, thickness, length, 16, 1),
+    tBar: new CylinderGeometry(thickness, thickness, tBarLength, 12, 1),
+    tBarCap: new SphereGeometry(thickness, 12, 12),
+    endCap: new SphereGeometry(thickness, 16, 16),
+    grip: new TorusGeometry(thickness * 1.15, thickness * 0.15, 12, 24),
+  };
+  geometrySets.set(key, geometry);
+  return geometry;
+}
+
+function getStaffMaterialSet(color: "blue" | "red"): StaffMaterialSet {
+  const cached = materialSets.get(color);
+  if (cached) return cached;
+
+  const palette =
+    color === "blue"
+      ? { main: "#3b82f6", dark: "#1d4ed8" }
+      : { main: "#ef4444", dark: "#b91c1c" };
+  const materials = {
+    main: new MeshStandardMaterial({
+      color: palette.main,
+      roughness: 0.3,
+      metalness: 0.2,
+    }),
+    dark: new MeshStandardMaterial({
+      color: palette.dark,
+      roughness: 0.3,
+      metalness: 0.2,
+    }),
+    grip: new MeshStandardMaterial({
+      color: "white",
+      roughness: 0.4,
+      metalness: 0.1,
+    }),
+    trail: new MeshBasicMaterial({
+      color: palette.main,
+      opacity: 0.3,
+      transparent: true,
+    }),
+  };
+  materialSets.set(color, materials);
+  return materials;
+}
+
+function mesh(
+  geometry: CylinderGeometry | SphereGeometry | TorusGeometry,
+  material: MeshBasicMaterial | MeshStandardMaterial,
+  layer: number,
+): Mesh {
+  const result = new Mesh(geometry, material);
+  result.layers.set(layer);
+  return result;
+}
+
+/**
+ * Build the canonical rendered staff without a framework dependency.
+ *
+ * Staff3D.svelte and worker renderers both mount this exact object. Geometry
+ * and materials remain module-cached just as the original component's module
+ * script did; an instance dispose therefore detaches its graph without
+ * destroying resources shared by another performer.
+ */
+export function createStaffObject(options: StaffObjectOptions): StaffObject {
+  const layer = options.layer ?? 0;
+  const geometry = getStaffGeometrySet(options.length, options.thickness);
+  const materials = getStaffMaterialSet(options.color);
+  const halfLength = options.length / 2;
+  const tBarLength = options.length * 0.228;
+
+  const root = new Group();
+  root.name = `staff-${options.color}`;
+  root.layers.set(layer);
+
+  const rotated = new Group();
+  rotated.name = "staff-rotated-body";
+  rotated.layers.set(layer);
+  root.add(rotated);
+
+  rotated.add(mesh(geometry.shaft, materials.main, layer));
+
+  const thumbEnd = new Group();
+  thumbEnd.name = "staff-thumb-end";
+  thumbEnd.position.y = halfLength;
+  thumbEnd.layers.set(layer);
+  rotated.add(thumbEnd);
+
+  const crossbar = mesh(geometry.tBar, materials.main, layer);
+  crossbar.rotation.z = Math.PI / 2;
+  thumbEnd.add(crossbar);
+
+  const leftCap = mesh(geometry.tBarCap, materials.dark, layer);
+  leftCap.position.x = -tBarLength / 2;
+  thumbEnd.add(leftCap);
+
+  const rightCap = mesh(geometry.tBarCap, materials.dark, layer);
+  rightCap.position.x = tBarLength / 2;
+  thumbEnd.add(rightCap);
+
+  const pinkyCap = mesh(geometry.endCap, materials.dark, layer);
+  pinkyCap.position.y = -halfLength;
+  rotated.add(pinkyCap);
+
+  rotated.add(mesh(geometry.grip, materials.grip, layer));
+
+  const trail = mesh(trailGeometry, materials.trail, layer);
+  trail.name = "staff-trail-indicator";
+  root.add(trail);
+
+  const finalQuaternion = new Quaternion();
+  return {
+    root,
+    setState(state) {
+      finalQuaternion
+        .copy(state.worldRotation)
+        .multiply(HORIZONTAL_QUAT);
+      rotated.quaternion.copy(finalQuaternion);
+    },
+    dispose() {
+      root.removeFromParent();
+      root.clear();
+    },
+  };
+}
