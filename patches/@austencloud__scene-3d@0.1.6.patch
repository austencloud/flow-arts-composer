+export const FACE_RADIUS = 0.09;
+export const FOREARM_RADIUS = 0.04;
+export const BODY_CLEARANCE_PADDING = 0.02;
+export const FOREARM_FACE_CLEARANCE = FACE_RADIUS + FOREARM_RADIUS + BODY_CLEARANCE_PADDING;
+export const NECK_RADIUS = 0.07;
+export const TORSO_RADIUS = 0.12;
+export const FOREARM_NECK_CLEARANCE = NECK_RADIUS + FOREARM_RADIUS + BODY_CLEARANCE_PADDING;
+export const FOREARM_TORSO_CLEARANCE = TORSO_RADIUS + FOREARM_RADIUS;
+const FACE_FORWARD_OFFSET = 0.08;
+const FACE_UP_OFFSET = 0.05;
+/**
+ * The mapped head joint sits near the base of the skull on the rigs we ship.
+ * This point follows the visible face instead, using the live shoulder line so
+ * the offset remains correct when the performer turns or a model mirrors X.
+ */
+export function computeFaceCenter(head, leftShoulder, rightShoulder, out, rightScratch, forwardScratch) {
+    rightScratch.subVectors(rightShoulder, leftShoulder);
+    rightScratch.y = 0;
+    if (rightScratch.lengthSq() > 1e-6) {
+        rightScratch.normalize();
+        forwardScratch
+            .set(-rightScratch.z, 0, rightScratch.x)
+            .normalize();
+    }
+    else {
+        forwardScratch.set(0, 0, 1);
+    }
+    out.copy(head).addScaledVector(forwardScratch, FACE_FORWARD_OFFSET);
+    out.y += FACE_UP_OFFSET;
+    return out;
+}
+export function pointToSegmentDistance(point, segmentStart, segmentEnd, pointOffsetScratch, segmentScratch, closestOut) {
+    pointOffsetScratch.subVectors(point, segmentStart);
+    segmentScratch.subVectors(segmentEnd, segmentStart);
+    const lengthSq = segmentScratch.lengthSq();
+    if (lengthSq < 1e-8) {
+        closestOut.copy(segmentStart);
+        return point.distanceTo(segmentStart);
+    }
+    const t = Math.max(0, Math.min(1, pointOffsetScratch.dot(segmentScratch) / lengthSq));
+    closestOut.copy(segmentStart).addScaledVector(segmentScratch, t);
+    return point.distanceTo(closestOut);
+}
