+    const shape = trace(new Shape(), OUTLINE, length, false);
+    shape.holes = [
+        trace(new Path(), STAR_HOLE, length, false),
+        trace(new Path(), STAR_HOLE, length, true),
+    ];
+    return shape;
+}
