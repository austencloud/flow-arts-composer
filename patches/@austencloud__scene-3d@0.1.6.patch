new file mode 100644
index 0000000000000000000000000000000000000000..659491c87669856c213fd41dabbf8171b30282bd
--- /dev/null
+++ b/src/lib/services/leg-geometry.ts
@@ -0,0 +1,366 @@
+import {
+  Quaternion,
+  Vector3,
+  type Bone,
+  type Matrix4,
+  type Object3D,
+} from "three";
+import type { BoneChain } from "./contracts/IAvatarSkeletonBuilder";
+
+const parentWorld = new Vector3();
+const childWorld = new Vector3();
+const toeWorld = new Vector3();
+const tipWorld = new Vector3();
+
+/**
+ * Measure a two-bone IK chain from a rig standing in its rest pose.
+ *
+ * Both arms and both legs are the same measurement, and the bake that
+ * contact-retargets a clip needs a fourth one against a rig it was handed
+ * rather than built. Call it with the rig posed at rest: every number here is
+ * a bind-pose property, and reading them off an animated frame gives a chain
+ * whose lengths change as the character moves.
+ */
+export function buildTwoBoneChain(
+  root: Bone,
+  middle: Bone,
+  effector: Bone
+): BoneChain {
+  const upperLength = boneLength(root, middle);
+  const lowerLength = boneLength(middle, effector);
+  return {
+    root,
+    middle,
+    effector,
+    totalLength: upperLength + lowerLength,
+    upperLength,
+    lowerLength,
+    rootRestDir: restDirection(root, middle),
+    middleRestDir: restDirection(middle, effector),
+  };
+}
+
+function boneLength(parent: Bone, child: Bone): number {
+  parent.getWorldPosition(parentWorld);
+  child.getWorldPosition(childWorld);
+  return parentWorld.distanceTo(childWorld);
+}
+
+/** Which way the bone points, in its own parent's space. */
+function restDirection(parent: Bone, child: Bone): Vector3 {
+  parent.getWorldPosition(parentWorld);
+  child.getWorldPosition(childWorld);
+  const direction = childWorld.clone().sub(parentWorld).normalize();
+  return direction
+    .transformDirection(parent.matrixWorld.clone().invert())
+    .normalize();
+}
+
+/**
+ * The lowest point of the front of the foot, in `toSpace` or in world.
+ *
+ * A plant holds one joint and the foot carries on in front of it, so the
+ * height that decides whether a shoe is through the floor is not the height of
+ * anything being held. Infinity when the rig has no toe: nothing to clear.
+ */
+export function footLowestPoint(
+  toe: Object3D | null,
+  toSpace?: Matrix4
+): number {
+  if (!toe) return Infinity;
+  toe.getWorldPosition(toeWorld);
+  if (toSpace) toeWorld.applyMatrix4(toSpace);
+  let lowest = toeWorld.y;
+  const tip = toe.children.find((child) => child.name.endsWith("Toe_End"));
+  if (tip) {
+    tip.getWorldPosition(tipWorld);
+    if (toSpace) tipWorld.applyMatrix4(toSpace);
+    lowest = Math.min(lowest, tipWorld.y);
+  }
+  return lowest;
+}
+
+/**
+ * How far above the ball of the foot the floor has to be held for the whole
+ * shoe to clear it.
+ *
+ * What a plant holds is one joint, and the foot carries on in front of it.
+ * Retarget a walk onto a rig whose foot sits at a different angle and the tip
+ * hangs over a centimetre below that joint, so holding the joint at the floor
+ * puts the tip through it. It is the foot's current roll, so it changes every
+ * frame of a stance rather than once per clip.
+ *
+ * Call with world matrices current.
+ */
+export function toeTipClearance(
+  toe: Object3D | null,
+  floor: number,
+  toSpace?: Matrix4
+): number {
+  if (!toe) return floor;
+  const lowest = footLowestPoint(toe, toSpace);
+  if (!Number.isFinite(lowest)) return floor;
+  toe.getWorldPosition(toeWorld);
+  if (toSpace) toeWorld.applyMatrix4(toSpace);
+  return Math.max(floor, toeWorld.y - lowest);
+}
+
+/* ------------------------------------------------------------------------ *
+ * Standing stance
+ *
+ * A performer whose legs nobody is driving shows the audience whatever its
+ * GLB authored as a bind pose, for the whole performance. Those bind poses
+ * disagree: the Mixamo-derived catalog rigs are authored in an A-pose whose
+ * ankles sit ~320 mm apart, and the intake rig is authored standing, ankles
+ * directly under its hip sockets at ~240 mm.
+ *
+ * What used to run in Avatar3D was a fixed 8-degree rotation about each upper
+ * leg's own local Z. A bone's local axes are a property of the export, not of
+ * the body, so one constant read as abduction on one rig and adduction on the
+ * next: it splayed ch18 from 321 mm to 549 mm, and it closed the intake rig
+ * from 239 mm to 18 mm, which is the feet-stuck-together silhouette.
+ *
+ * These three functions replace the constant with a measurement: read the
+ * rig's own hip sockets and ankles, plan the frontal-plane rotation that puts
+ * the ankles a body-derived distance apart, apply it in world space so no
+ * bone naming or axis convention is assumed.
+ *
+ * This is a static standing base, not locomotion. It owns no gait clock, no
+ * contact schedule and no footfall plan. Once a clip or a planner drives the
+ * legs, that owner writes these bones every frame and this pose is gone,
+ * which is the intended relationship.
+ * ------------------------------------------------------------------------ */
+
+/**
+ * Where the ankles sit, as a multiple of the rig's own hip-socket separation.
+ *
+ * 1 puts each ankle directly beneath its own hip socket, so the femurs hang
+ * vertical in the frontal plane. That is the neutral base a person takes when
+ * they are about to move: wide enough to read as support, narrow enough that
+ * turning the torso hard to one side does not fight the legs. It is also the
+ * ratio the intake rig's author chose by hand.
+ */
+export const STANDING_ANKLE_TO_HIP_RATIO = 1;
+
+/** One leg, measured in the frontal plane of the body that owns it. */
+export interface StandingLegSample {
+  /** Lateral offset of this hip socket from the pelvis midline, signed toward the rig's left. */
+  hipLateral: number;
+  /** Lateral offset of the ankle from its own hip socket, same axis. */
+  ankleLateralFromHip: number;
+  /** How far the ankle hangs below the hip socket. Positive on a standing rig. */
+  ankleDropFromHip: number;
+}
+
+export interface StandingStanceSample {
+  left: StandingLegSample;
+  right: StandingLegSample;
+  /** Body lateral axis, pointing toward the rig's left. */
+  lateral: Vector3;
+  /** Body vertical axis, ankles toward hips. */
+  up: Vector3;
+  /** `lateral x up`. A positive rotation about it swings an ankle to the rig's left. */
+  abductionAxis: Vector3;
+}
+
+export interface StandingLegPlan {
+  /** Frontal-plane rotation for this upper leg, about `abductionAxis`. */
+  abductionRad: number;
+  /** Where the ankle lands laterally, relative to the pelvis midline. */
+  ankleLateral: number;
+  /** How far the ankle rises. Negative means it settles lower. */
+  ankleRise: number;
+}
+
+export interface StandingStancePlan {
+  left: StandingLegPlan;
+  right: StandingLegPlan;
+  /** Distance between the hip sockets the plan is derived from. */
+  hipSeparation: number;
+  /** Ankle separation before the plan is applied. */
+  currentAnkleSeparation: number;
+  /** Ankle separation the plan lands on. */
+  targetAnkleSeparation: number;
+  /**
+   * Mean height change of the two ankles. A host that grounds a rig from its
+   * bind-pose bounding box has to fold this into its feet offset, or the soles
+   * float above or sink below the floor by exactly this much.
+   */
+  ankleRise: number;
+}
+
+const hipL = new Vector3();
+const hipR = new Vector3();
+const ankleL = new Vector3();
+const ankleR = new Vector3();
+const stanceUp = new Vector3();
+const stanceLateral = new Vector3();
+const hipToAnkle = new Vector3();
+const ankleMid = new Vector3();
+
+/**
+ * Measure a rig's standing base off its own skeleton.
+ *
+ * Both axes come from the body rather than from the world: up runs from the
+ * ankle midpoint to the hip midpoint, and lateral is the hip-to-hip direction
+ * with that up component removed. Nothing here reads a bone name, a local
+ * axis, or a character id, so a newly authored rig is measured rather than
+ * tabulated.
+ *
+ * Call with world matrices current. Returns null for a degenerate skeleton
+ * (coincident hips or coincident ankles), where there is no frontal plane to
+ * work in.
+ */
+export function measureStandingStance(
+  leftUpLeg: Object3D,
+  rightUpLeg: Object3D,
+  leftFoot: Object3D,
+  rightFoot: Object3D
+): StandingStanceSample | null {
+  leftUpLeg.getWorldPosition(hipL);
+  rightUpLeg.getWorldPosition(hipR);
+  leftFoot.getWorldPosition(ankleL);
+  rightFoot.getWorldPosition(ankleR);
+
+  // Ankle midpoint to hip midpoint. On a standing rig this is the body's own
+  // vertical, and it stays correct when the whole performer is yawed.
+  ankleMid.copy(ankleL).add(ankleR).multiplyScalar(0.5);
+  stanceUp.copy(hipL).add(hipR).multiplyScalar(0.5).sub(ankleMid);
+  if (stanceUp.lengthSq() < 1e-12) return null;
+  stanceUp.normalize();
+
+  stanceLateral.copy(hipL).sub(hipR);
+  stanceLateral.addScaledVector(stanceUp, -stanceLateral.dot(stanceUp));
+  if (stanceLateral.lengthSq() < 1e-12) return null;
+  stanceLateral.normalize();
+
+  const lateral = stanceLateral.clone();
+  const up = stanceUp.clone();
+  const abductionAxis = lateral.clone().cross(up).normalize();
+  const midLateral = (hipL.dot(lateral) + hipR.dot(lateral)) / 2;
+
+  const sampleLeg = (hip: Vector3, ankle: Vector3): StandingLegSample => {
+    hipToAnkle.copy(ankle).sub(hip);
+    return {
+      hipLateral: hip.dot(lateral) - midLateral,
+      ankleLateralFromHip: hipToAnkle.dot(lateral),
+      ankleDropFromHip: -hipToAnkle.dot(up),
+    };
+  };
+
+  return {
+    left: sampleLeg(hipL, ankleL),
+    right: sampleLeg(hipR, ankleR),
+    lateral,
+    up,
+    abductionAxis,
+  };
+}
+
+function planLeg(
+  leg: StandingLegSample,
+  targetAnkleLateral: number
+): StandingLegPlan {
+  // The hip-to-ankle vector, restricted to the plane a frontal rotation moves.
+  // Its fore-aft component rides along unchanged and only shortens the radius.
+  const radius = Math.hypot(leg.ankleLateralFromHip, leg.ankleDropFromHip);
+  if (radius < 1e-6) {
+    return { abductionRad: 0, ankleLateral: leg.hipLateral, ankleRise: 0 };
+  }
+
+  const wanted = targetAnkleLateral - leg.hipLateral;
+  // Angle away from straight down, positive toward the rig's left.
+  const current = Math.atan2(leg.ankleLateralFromHip, leg.ankleDropFromHip);
+  // A rigid leg cannot reach further sideways than it is long, so a target
+  // outside that circle resolves to the widest base the leg actually has.
+  const target = Math.asin(Math.max(-1, Math.min(1, wanted / radius)));
+
+  return {
+    abductionRad: target - current,
+    ankleLateral: leg.hipLateral + radius * Math.sin(target),
+    // A bigger drop hangs the ankle lower, so a rise is the drop shrinking.
+    ankleRise: radius * Math.cos(current) - radius * Math.cos(target),
+  };
+}
+
+/**
+ * Plan the frontal-plane rotation each upper leg needs so the ankles land a
+ * body-derived distance apart.
+ *
+ * Both legs are planned against the same target separation, so the base stays
+ * symmetric about the pelvis midline even on a rig whose two legs were
+ * authored differently.
+ */
+export function planStandingStance(
+  sample: Pick<StandingStanceSample, "left" | "right">,
+  ankleToHipRatio: number = STANDING_ANKLE_TO_HIP_RATIO
+): StandingStancePlan {
+  const hipSeparation = Math.abs(
+    sample.left.hipLateral - sample.right.hipLateral
+  );
+  const currentAnkleSeparation = Math.abs(
+    sample.left.hipLateral +
+      sample.left.ankleLateralFromHip -
+      (sample.right.hipLateral + sample.right.ankleLateralFromHip)
+  );
+  const targetAnkleSeparation = hipSeparation * ankleToHipRatio;
+  // Lateral points toward the rig's left, so the left ankle belongs on the
+  // positive side of the midline and the right ankle on the negative side.
+  const left = planLeg(sample.left, targetAnkleSeparation / 2);
+  const right = planLeg(sample.right, -targetAnkleSeparation / 2);
+
+  return {
+    left,
+    right,
+    hipSeparation,
+    currentAnkleSeparation,
+    targetAnkleSeparation,
+    ankleRise: (left.ankleRise + right.ankleRise) / 2,
+  };
+}
+
+const stanceRotation = new Quaternion();
+const boneWorldQuat = new Quaternion();
+const parentWorldQuat = new Quaternion();
+const footWorldQuat = new Quaternion();
+
+/**
+ * Rotate the upper legs into a planned stance, leaving the soles as authored.
+ *
+ * The rotation is applied in world space about the measured `abductionAxis`,
+ * so it does not care which way an exporter happened to point a femur's local
+ * axes. Each foot's world orientation is captured before its leg moves and
+ * restored afterwards: rotating a femur carries the whole chain with it, and
+ * without the restore the sole tips off the floor by the same angle.
+ */
+export function applyStandingStance(
+  legs: { upLeg: Object3D; foot: Object3D; plan: StandingLegPlan }[],
+  abductionAxis: Vector3
+): void {
+  for (const { upLeg, foot, plan } of legs) {
+    if (!Number.isFinite(plan.abductionRad) || plan.abductionRad === 0) continue;
+
+    upLeg.updateWorldMatrix(true, false);
+    foot.updateWorldMatrix(true, false);
+    foot.getWorldQuaternion(footWorldQuat);
+
+    upLeg.getWorldQuaternion(boneWorldQuat);
+    stanceRotation.setFromAxisAngle(abductionAxis, plan.abductionRad);
+    boneWorldQuat.premultiply(stanceRotation);
+    if (upLeg.parent) {
+      upLeg.parent.getWorldQuaternion(parentWorldQuat);
+      upLeg.quaternion.copy(parentWorldQuat.invert()).multiply(boneWorldQuat);
+    } else {
+      upLeg.quaternion.copy(boneWorldQuat);
+    }
+    upLeg.updateMatrixWorld(true);
+
+    if (foot.parent) {
+      foot.parent.getWorldQuaternion(parentWorldQuat);
+      foot.quaternion.copy(parentWorldQuat.invert()).multiply(footWorldQuat);
+    } else {
+      foot.quaternion.copy(footWorldQuat);
+    }
+    foot.updateMatrixWorld(true);
+  }
+}
