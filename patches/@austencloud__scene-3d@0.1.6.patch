+/**
+ * Segments around the tube's cross-section (Three's `radialSegments`). The tube
+ * is only 7.9mm in radius, so 20 leaves a 0.10mm sagitta and the silhouette
+ * reads round.
+ */
+export const HOOP_TUBE_SEGMENTS = 20;
