+};
+
+/** The curved triangle at the centre, where all three lobes overlap. */
+const HOLE_CORE: Contour = {
+  start: [0.08228, 0.21242],
+  curves: [
+    [0.06942, 0.15822, 0.04095, 0.10899, 0.0004, 0.07081],
