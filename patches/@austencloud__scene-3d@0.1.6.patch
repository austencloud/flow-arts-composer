+<script module lang="ts">
+  import { SphereGeometry, TorusGeometry } from "three";
+  import {
+    TRIANGLE_ARC_ANGLE,
+    TRIANGLE_BOW_RADIUS_M,
+    TRIANGLE_ELBOW_LEG_ANGLE,
+    TRIANGLE_SIDE_SEGMENTS,
