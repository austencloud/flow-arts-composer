@@ -0,0 +1,77 @@
+/**
+ * Prop Finish State
+ *
+ * Some props exist in two real builds: the fire one you burn and the day one
+ * you practise with. A triad is steel spines and kevlar wicks, or a printed hub
+ * and glow heads. Same prop, same reach, same notation — different object.
+ *
+ * That is a display preference, not a notation change. This state supplies the
+ * scene default; a performer can override any part of the build independently.
+ */
+import { PropType } from "../domain/enums/PropType";
+class PropFinishState {
+    _finish = $state("fire");
+    _fanBuild = $state("pictograph");
+    _fanFrameColor = $state("black");
+    _fanCover = $state("bare");
+    get finish() {
+        return this._finish;
+    }
+    set(finish) {
+        this._finish = finish;
+    }
+    toggle() {
+        this._finish = this._finish === "fire" ? "day" : "fire";
+    }
+    get fanBuild() {
+        return this._fanBuild;
+    }
+    setFanBuild(build) {
+        this._fanBuild = build;
+    }
+    get fanFrameColor() {
+        return this._fanFrameColor;
+    }
+    setFanFrameColor(color) {
+        this._fanFrameColor = color;
+    }
+    get fanCover() {
+        return this._fanCover;
+    }
+    get build() {
+        return {
+            finish: this._finish,
+            fanBuild: this._fanBuild,
+            fanFrameColor: this._fanFrameColor,
+            fanCover: this._fanCover,
+        };
+    }
+    setFanCover(cover) {
+        this._fanCover = cover;
+    }
+}
+export const propFinishState = new PropFinishState();
+/**
+ * The props Prop3D actually builds twice. Everything else ignores the finish,
+ * so a Fire/Day control shown next to them is a switch wired to nothing --
+ * surfaces ask this before offering the choice.
+ *
+ * A fire double staff and an LED baton are NOT on this list: those are separate
+ * objects with their own reach and their own notation entry, not two builds of
+ * one prop.
+ */
+const PROPS_WITH_FINISH_VARIANTS = new Set([
+    PropType.TRIAD,
+    PropType.BIGTRIAD,
+    PropType.QUIAD,
+]);
+export function propHasFinishVariants(propType) {
+    return PROPS_WITH_FINISH_VARIANTS.has(propType);
+}
+const PROPS_WITH_FAN_APPEARANCE = new Set([
+    PropType.FAN,
+    PropType.BIGFAN,
+]);
+export function propHasFanAppearanceOptions(propType) {
+    return PROPS_WITH_FAN_APPEARANCE.has(propType);
+}
