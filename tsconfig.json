{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // @austencloud/video-editor dev loop (extraction steps 0 to 3), removed
    // with the vite.config.ts aliases in step 4. The package resolves from the
    // shared-packages worktree build output. Its declarations would otherwise
    // load a second copy of svelte and zod from that worktree: two copies of
    // svelte's ambient types make every Snippet prop mismatch, and zod's types
    // carry its version. So svelte and zod are pinned to this app's copies.
    // Each pin lists ../node_modules second for svelte-fast-check, which
    // copies these paths into .fast-check/tsconfig.json unchanged.
    "paths": {
      "@austencloud/video-editor/css": [
        "E:/worktrees/shared-packages/video-editor/packages/video-editor/css"
      ],
      "@austencloud/video-editor/css/*": [
        "E:/worktrees/shared-packages/video-editor/packages/video-editor/css/*"
      ],
      "@austencloud/video-editor": [
        "E:/worktrees/shared-packages/video-editor/packages/video-editor/dist"
      ],
      "@austencloud/video-editor/*": [
        "E:/worktrees/shared-packages/video-editor/packages/video-editor/dist/*"
      ],
      "svelte": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/action": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/animate": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/attachments": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/compiler": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/easing": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/elements": [
        "./node_modules/svelte/elements.d.ts",
        "../node_modules/svelte/elements.d.ts"
      ],
      "svelte/legacy": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/motion": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/reactivity": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/reactivity/window": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/server": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/store": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/transition": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "svelte/events": [
        "./node_modules/svelte/types/index.d.ts",
        "../node_modules/svelte/types/index.d.ts"
      ],
      "zod": [
        "./node_modules/zod/index.d.cts",
        "../node_modules/zod/index.d.cts"
      ],
      "zod/mini": [
        "./node_modules/zod/mini/index.d.cts",
        "../node_modules/zod/mini/index.d.cts"
      ],
      "zod/locales": [
        "./node_modules/zod/locales/index.d.cts",
        "../node_modules/zod/locales/index.d.cts"
      ],
      "zod/v3": [
        "./node_modules/zod/v3/index.d.cts",
        "../node_modules/zod/v3/index.d.cts"
      ],
      "zod/v4": [
        "./node_modules/zod/v4/index.d.cts",
        "../node_modules/zod/v4/index.d.cts"
      ],
      "zod/v4-mini": [
        "./node_modules/zod/v4-mini/index.d.cts",
        "../node_modules/zod/v4-mini/index.d.cts"
      ],
      "zod/v4/mini": [
        "./node_modules/zod/v4/mini/index.d.cts",
        "../node_modules/zod/v4/mini/index.d.cts"
      ],
      "zod/v4/core": [
        "./node_modules/zod/v4/core/index.d.cts",
        "../node_modules/zod/v4/core/index.d.cts"
      ],
      "zod/v4/locales": [
        "./node_modules/zod/v4/locales/index.d.cts",
        "../node_modules/zod/v4/locales/index.d.cts"
      ],
      "zod/v4/locales/*": [
        "./node_modules/zod/v4/locales/*",
        "../node_modules/zod/v4/locales/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "moduleResolution": "Bundler",
    "customConditions": ["svelte"],
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,

    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "checkJs": false,
    "types": ["$app/types", "vite/client", "web-bluetooth"],
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte"],
  "exclude": [
    "node_modules",
    "dist",
    "./build",
    "./build/**",
    ".svelte-kit",
    ".vercel_build_output",
    ".vercel",
    "archive",
    "legacy_web_app",
    "**/*.js"
  ]
}
