rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // A "full" user has a permanent credential (not an anonymous session).
    // Free check — no document read, unlike the role helpers.
    function isFullUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Check if user owns the document (based on userId field)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the incoming data has the correct userId
    function hasValidUserId() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // Arrow-placement persistence is authored in one rotational frame.
    // Diamond and Box are display orientations, never storage ownership keys.
    function hasValidPlacementFrame() {
      let data = request.resource.data;
      return data.keys().hasAll(['placementFrame'])
        && !data.keys().hasAny(['gridMode'])
        && (
          data.placementFrame == 'canonical'
          || data.placementFrame == 'skewed'
        );
    }

    function hasEncodedShortcodePayload() {
      let data = request.resource.data;
      return data.keys().hasAny(['encoded'])
        && data.encoded is string
        && data.encoded.size() > 0;
    }

    function hasEmbeddedWordShortcodePayload() {
      let data = request.resource.data;
      return data.keys().hasAny(['sequenceData'])
        && data.sequenceData is map
        && data.sequenceData.keys().hasAny(['steps'])
        && data.sequenceData.steps is list
        && data.sequenceData.steps.size() == data.get('payloadStepCount', 0);
    }

    function hasEmbeddedSoloShortcodePayload() {
      let data = request.resource.data;
      return data.keys().hasAny(['soloData'])
        && data.soloData is map
        && data.soloData.keys().hasAll([
          'id',
          'steps',
          'startLocation',
          'startOrientation',
          'contentHash',
          'handPath',
          'length',
          'bigrams',
          'impliedGridMode',
          'authoredHand'
        ])
        && (
          !data.keys().hasAny(['sourceSoloPropId'])
          || data.soloData.id == data.get('sourceSoloPropId', '')
        )
        && data.soloData.contentHash == data.get('payloadContentHash', '')
        && data.soloData.authoredHand == data.get('authoredHand', '')
        && data.soloData.steps is list
        && data.soloData.steps.size() == data.get('payloadStepCount', 0)
        && data.soloData.length == data.get('payloadStepCount', 0);
    }

    function isValidWordShortcodeMint() {
      let data = request.resource.data;
      return data.get('payloadKind', 'word') == 'word'
        && data.get('payloadSchemaVersion', 0) == 2
        && data.get('payloadWord', '') is string
        && data.get('payloadWord', '').size() > 0
        && data.get('payloadStepCount', 0) is int
        && data.get('payloadStepCount', 0) > 0
        && !data.keys().hasAny([
          'payloadTitle',
          'payloadContentHash',
          'authoredHand',
          'sourceSoloPropId',
          'soloData'
        ])
        && (hasEncodedShortcodePayload() || hasEmbeddedWordShortcodePayload());
    }

    function isValidSoloShortcodeMint() {
      let data = request.resource.data;
      return data.get('payloadKind', '') == 'solo'
        && data.get('payloadSchemaVersion', 0) == 3
        && data.get('payloadTitle', '') is string
        && data.get('payloadTitle', '').size() > 0
        && data.get('payloadTitle', '').size() <= 160
        && data.get('payloadStepCount', 0) is int
        && data.get('payloadStepCount', 0) > 0
        && data.get('payloadContentHash', '') is string
        && data.get('payloadContentHash', '').size() == 22
        && (
          data.get('authoredHand', '') == 'left'
          || data.get('authoredHand', '') == 'right'
        )
        && (
          !data.keys().hasAny(['sourceSoloPropId'])
          || (
            data.get('sourceSoloPropId', '') is string
            && data.get('sourceSoloPropId', '').size() > 0
          )
        )
        && data.get('sequence', '') == data.get('payloadTitle', '')
        && data.get('sequenceName', '') == data.get('payloadTitle', '')
        && !data.keys().hasAny(['payloadWord', 'sequenceData'])
        && (
          (
            hasEncodedShortcodePayload()
            && !data.keys().hasAny(['soloData'])
          )
          || (
            !data.keys().hasAny(['encoded'])
            && hasEmbeddedSoloShortcodePayload()
          )
        );
    }

    // Privilege is granted only by Firebase Auth custom claims. Public profile
    // fields are a display projection and must never be an authorization source.
    function isAdmin() {
      return !isAuthenticated() ? false
        : ((request.auth.token.keys().hasAny(['admin'])
              ? request.auth.token.admin == true : false)
          || (request.auth.token.keys().hasAny(['isAdmin'])
              ? request.auth.token.isAdmin == true : false)
          || (request.auth.token.keys().hasAny(['role'])
              ? request.auth.token.role == 'admin' : false));
    }

    // Check if user is at least tester level
    function isTester() {
      return !isAuthenticated() ? false
        : (isAdmin()
          || (request.auth.token.keys().hasAny(['role'])
              ? request.auth.token.role == 'tester' : false));
    }

    // -------------------------------------------------------------------------
    // DEVELOPER SYSTEM HELPERS (uses developers collection)
    // -------------------------------------------------------------------------

    // Check if user is an approved, active developer
    function isApprovedDeveloper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/developers/$(request.auth.uid))
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.active == true;
    }

    // Check if user has admin role in the developers collection
    function isDeveloperAdmin() {
      return isApprovedDeveloper()
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.role == "admin";
    }

    // Check if user has contributor role in the developers collection
    function isContributor() {
      return isApprovedDeveloper()
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.role == "contributor";
    }

    // Check if user has verified their age (18+) for Hall of Shame access
    function isAgeVerified() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/userPrivateProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userPrivateProfiles/$(request.auth.uid)).data.ageVerifiedAt != null;
    }

    // ============================================================================
    // CONFIG COLLECTIONS
    // ============================================================================

    // Feature flags configuration - readable by all (including guests), writable by admins only
    // Must allow unauthenticated reads: PostHogFeatureFlagService loads + subscribes to
    // global flag overrides for guests so they see the correct enabled feature set.
    // Flags are non-sensitive (enabled toggles + min-role gates), same class as fireDefaults.
    match /config/featureFlags {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Video categories configuration - readable by authenticated users, writable by admins
    match /config/videoCategories {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quick performers configuration - readable by authenticated users, writable by admins
    match /config/quickPerformers {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Effect point positions - readable by all (pre-auth safe), writable by admins
    // Stores fire/LED point positions that apply to all users globally
    match /config/effectPoints {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fire effect defaults - readable by all (including pre-auth), writable by admins
    // Must allow unauthenticated reads: FireDefaultsLoader runs during DI
    // container construction before auth completes
    match /config/fireDefaults {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Prop geometry adjustments - arrow positioning offsets for pictograph rendering
    // Readable by all (needed pre-auth for rendering), writable by admins
    match /prop_geometry_adjustments/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && hasValidPlacementFrame()
        && docId.matches('^' + request.resource.data.placementFrame + '[|].*');
      allow delete: if isAdmin();
    }

    // Guide sequence overrides (Level 1 Guide Companion v2) - the printed guide
    // is public, so overrides are public-read; editing a broken guide strip is
    // admin-only. Revisions subcollection snapshots the replaced state for
    // in-app revert, same admin gate.
    match /guideOverrides/{stripKey} {
      allow read: if true;
      allow write: if isAdmin();

      match /revisions/{revisionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Feature flag audit log - append-only for admins
    match /audit/featureFlags/entries/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    // Announcements - read by authenticated users, write by admins
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================================
    // USERNAME INDEX (Uniqueness Enforcement)
    // ============================================================================

    // Username index - maps lowercase username to userId for uniqueness enforcement
    // Document ID is the lowercase username, document contains userId of owner
    match /usernames/{usernameLowercase} {
      // Anyone authenticated can check username availability
      allow read: if isAuthenticated();

      // Create: User can claim an unclaimed username for themselves
      allow create: if isFullUser()
        && request.resource.data.userId == request.auth.uid;

      // Update: Only the owner can update their username claim
      // (e.g., to update timestamps or reclaim after releasing)
      allow update: if isFullUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Delete: Only owner can release their username, or admin for cleanup
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // USER DATA COLLECTIONS
    // ============================================================================

    // -------------------------------------------------------------------------
    // INTENTIONAL PUBLIC READ ACCESS
    // -------------------------------------------------------------------------
    // The following collections use `allow read: if true` BY DESIGN.
    // This is NOT a security vulnerability - it's required for:
    //
    // 1. /users/{userId} - Public user profiles
    //    - Enables: Creator profiles, leaderboards, social features
    //    - Contains: Display name, avatar, public stats (XP, level, sequence count)
    //    - Sensitive data (email, settings) stored in protected subcollections
    //
    // NOTE: collections are NOT in this `if true` list. A collection doc is
    // readable only when isPublic == true (or by its owner/admin) — see the
    // per-user and root /collections rules below. This is enforced server-side
    // so a collectionGroup query cannot enumerate private collections.
    //
    // 2. /sequences - Public sequences index
    //    - Enables: Browse page, search, gallery browsing
    //    - Only contains sequences users explicitly published
    //
    // 3. /products - Subscription products catalog
    //    - Enables: Displaying pricing before auth
    //
    // SECURITY MODEL: mostly data separation, plus per-doc visibility gating
    // - Public profile/index data is stored in these public-readable collections
    // - Collections & sequences gate reads on their isPublic/visibility flag
    // - Private data (messages, settings, drafts) uses auth-gated rules
    // -------------------------------------------------------------------------

    // Server-only private metadata. Admin clients use the authenticated API;
    // Admin SDK access bypasses rules for migration and mutation.
    match /userAdminMetadata/{userId} {
      allow read, write: if false;
    }

    // User profiles - PUBLIC browsing allowed for everyone (even unauthenticated)
    // Users can only edit their own profile data
    match /users/{userId} {
      // Fields an account owner may maintain directly as part of their public
      // profile or client-auth synchronization. Privilege, moderation,
      // counters owned by server workflows, and private admin metadata are
      // deliberately absent.
      function ownerProfileFields() {
        return [
          'displayName', 'name', 'username', 'usernameLowercase',
          'photoURL', 'avatar',
          'updatedAt', 'lastActivityDate', 'isAnonymous',
          'bio', 'instagramUsername', 'pronouns', 'profileColor',
          'propsISpinWith', 'favoriteProp', 'favoriteCatdog', 'activeProp',
          'pinnedItems', 'favoriteConfig',
          'publicProfileVersion'
        ];
      }

      function publicProfileFields() {
        return [
          'publicProfileVersion',
          'displayName', 'name', 'username', 'usernameLowercase',
          'photoURL', 'avatar',
          'createdAt', 'updatedAt', 'lastActivityDate', 'isAnonymous',
          'bio', 'instagramUsername', 'pronouns', 'profileColor',
          'propsISpinWith', 'favoriteProp', 'favoriteCatdog', 'activeProp',
          'pinnedItems', 'favoriteConfig',
          'sequenceCount', 'collectionCount', 'followerCount', 'followingCount',
          'totalXP', 'currentLevel', 'achievementCount', 'currentStreak',
          'longestStreak',
          'role', 'isAdmin', 'isDisabled', 'isHidden', 'isFeatured'
        ];
      }

      function isSafePublicProfile(data) {
        return data.publicProfileVersion == 2
          && data.keys().hasOnly(publicProfileFields());
      }

      function hasSafeInitialPrivileges() {
        return isSafePublicProfile(request.resource.data)
          && (!('role' in request.resource.data) || request.resource.data.role == 'user')
          && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          && !('adminLabel' in request.resource.data)
          && !('adminNotes' in request.resource.data)
          && !('isDisabled' in request.resource.data)
          && (!('isHidden' in request.resource.data) || request.resource.data.isHidden == false)
          && (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured == false)
          && (!('sequenceCount' in request.resource.data) || request.resource.data.sequenceCount == 0)
          && (!('collectionCount' in request.resource.data) || request.resource.data.collectionCount == 0)
          && (!('followerCount' in request.resource.data) || request.resource.data.followerCount == 0)
          && (!('followingCount' in request.resource.data) || request.resource.data.followingCount == 0)
          && (!('totalXP' in request.resource.data) || request.resource.data.totalXP == 0)
          && (!('currentLevel' in request.resource.data) || request.resource.data.currentLevel == 1)
          && (!('achievementCount' in request.resource.data) || request.resource.data.achievementCount == 0)
          && (!('currentStreak' in request.resource.data) || request.resource.data.currentStreak == 0)
          && (!('longestStreak' in request.resource.data) || request.resource.data.longestStreak == 0);
      }

      // Legacy documents containing private admin metadata stay unavailable
      // to public direct reads. Public list queries must prove the migration
      // marker; signed admins retain list access for migration tooling.
      // The client provisions a missing profile only after an existence check.
      // Let the owner observe "not found" without exposing any existing legacy
      // document that still contains fields outside the public v2 contract.
      // AUTONOMOUS_REVIEW: missing-owner-profile-read:start
      allow get: if (isOwner(userId)
          && !exists(/databases/$(database)/documents/users/$(userId)))
        || isAdmin()
        || isSafePublicProfile(resource.data);
      // AUTONOMOUS_REVIEW: missing-owner-profile-read:end
      allow list: if isAdmin() || resource.data.publicProfileVersion == 2;

      // Users can only update their own profile
      allow create: if isOwner(userId) && hasSafeInitialPrivileges();

      // Allow updates for:
      // 1. Owner updating their own profile
      // 2. Admins updating any user's profile (role changes, moderation)
      // NOTE: followerCount manipulation removed from client-side rules.
      // Follow/unfollow must update counts via an Admin SDK endpoint (Cloud Function)
      // to prevent arbitrary count manipulation by any authenticated user.
      allow update: if (isAdmin() && isSafePublicProfile(request.resource.data))
        || (isOwner(userId)
          && isSafePublicProfile(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(ownerProfileFields()));

      // Users can delete their own profile, admins can delete any user (for testing)
      allow delete: if isOwner(userId) || isAdmin();

      // -------------------------------------------------------------------------
      // DEVICE LINKAGE (Scan Activity) — DeviceIdService writes here on sign-in
      // to link anonymous device scans to the user's account.
      // -------------------------------------------------------------------------
      match /devices/{deviceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if false;
      }

      // -------------------------------------------------------------------------
      // USER SETTINGS (Private - admin can read for impersonation preview)
      // -------------------------------------------------------------------------
      match /settings/{settingId} {
        // Admins can read any user's settings for impersonation/preview mode
        allow read: if isOwner(userId) || isAdmin();
        // Owners manage their settings. Admin feature overrides are an
        // explicitly privileged settings document.
        allow create, update: if (isOwner(userId) && settingId != 'featureOverrides')
          || (isAdmin() && settingId == 'featureOverrides');
        allow delete: if (isOwner(userId) && settingId != 'featureOverrides')
          || isAdmin();
      }

      match /moderation/{documentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin()
          || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hasActiveWarning'])
            && request.resource.data.hasActiveWarning == false);
        allow delete: if isAdmin();
      }

      // -------------------------------------------------------------------------
      // GENERATOR SETUPS (Saved generator configs. Every setup the current
      // client writes is public (a one-shot backfill flags pre-existing
      // docs): the collection-group rule below authorizes discovery reads,
      // and this rule covers the owner's own list plus admin impersonation
      // preview. Writes need a full account, must keep isPublic == true, and
      // must carry a string name of at most 60 characters and a map config;
      // the client never writes false. users/{uid}.favoriteConfig is a
      // retired projection and is no longer read or written.)
      // -------------------------------------------------------------------------
      match /generatorSetups/{setupId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && isFullUser()
          && request.resource.data.isPublic == true
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.config is map;
        allow delete: if isOwner(userId);
      }

      // Role-bound Post Studio / Compose layouts. Presets contain structure and
      // source roles, never uploaded media bytes or third-party credentials.
      match /mediaCompositionPresets/{presetId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // -------------------------------------------------------------------------
      // USER TAGS (Private)
      // -------------------------------------------------------------------------
      match /tags/{tagId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // PROP COLLECTION + NOTIFICATIONS (the XP/achievement/challenge/streak
      // gamification subcollections were removed 2026-06-26)
      // -------------------------------------------------------------------------

      // Prop unlock collection (single propCollection doc under gamification)
      match /gamification/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User notifications
      match /notifications/{notificationId} {
        // Admins can read for impersonation/preview mode
        allow read: if isOwner(userId) || isAdmin();
        // Admins can create notifications on behalf of users (e.g., moderation warnings)
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Dismissed announcements - users can read/write their own dismissals
      match /dismissedAnnouncements/{announcementId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Create module sessions - users can read/write their own sessions
      match /sessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // ONBOARDING STATUS
      // -------------------------------------------------------------------------
      match /onboarding/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // SEQUENCE DRAFTS (Autosave)
      // -------------------------------------------------------------------------
      match /drafts/{draftId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // POI IMAGE LIBRARY (Private)
      // -------------------------------------------------------------------------
      // Images the user uploaded in the POV Pattern Lab. Each doc stores the
      // metadata (name, dimensions, Storage URL); the binary lives in
      // /users/{uid}/poi-images/{id}.{ext} in Cloud Storage.
      match /poi-images/{imageId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // -------------------------------------------------------------------------
      // SOCIAL SUBCOLLECTIONS (Following/Followers)
      // -------------------------------------------------------------------------
      // Users can read anyone's following/followers lists (public social graph)
      // Users can only write to their own following list

      // Following list - who this user follows
      match /following/{followedUserId} {
        // Anyone can read follow relationships (for "is following" checks)
        allow read: if isAuthenticated();
        // Only the owner can add/remove follows, admins can delete
        allow create, update: if isOwner(userId) && isFullUser();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Followers list - who follows this user
      match /followers/{followerUserId} {
        // Anyone can read follower lists
        allow read: if isAuthenticated();
        // Written via transaction when someone follows/unfollows
        // The follower (followerUserId) writes to the target user's followers list
        allow create: if isFullUser() && request.auth.uid == followerUserId;
        allow update: if false; // No updates needed
        allow delete: if (isAuthenticated() && request.auth.uid == followerUserId) || isAdmin();
      }

      // Private connection data - notes about other users
      // Only the owner can read/write their own connection documents
      match /connections/{connectionId} {
        allow read, write: if isOwner(userId);
      }

      // -------------------------------------------------------------------------
      // USER LIBRARY (Sequences)
      // -------------------------------------------------------------------------
      // Public sequences are readable by anyone, private only by owner
      // Admins can read any user's sequences for impersonation/preview mode

      match /sequences/{sequenceId} {
        // Public sequences can be read by anyone, private only by owner
        // Admins can read any user's library (for impersonation/preview mode)
        allow read: if resource.data.visibility == 'public' || isOwner(userId) || isAdmin();
        // Owner can create/update, admins can update for data migrations.
        //
        // PHASE 4 (parity-repair spec): the owner document's projection
        // STAMPS are persister-transaction territory. Content fields (word,
        // steps, contentHash, visibility, …) stay freely writable — owner
        // saves are offline-first and must commit without a paired public
        // write; content drift until sync is the retry layer's and the
        // audit's domain. But a write that SETS the stamps must carry the
        // matching public mirror in the same transaction, and a write that
        // REMOVES them must remove the mirror with it. That is exactly what
        // publishPublicSequence / updatePublicThumbnails /
        // unpublishPublicSequence produce, and nothing else client-side
        // writes these keys (verified 2026-07-27: only
        // public-sequence-persister.ts).
        allow create: if isOwner(userId);
        allow update: if (isOwner(userId) || isAdmin())
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['publicProjectionRevision', 'publicProjectionSchemaVersion', 'publicProjectionDigest'])
            || ownerStampWriteProven(userId, sequenceId)
          );
        // A stamped owner document (published mirror) may only be deleted
        // when the mirror is gone after the same transaction
        // (deleteSequenceCompletely). An unstamped document deletes freely.
        allow delete: if (isOwner(userId) || isAdmin())
          && (
            !resource.data.keys().hasAny(['publicProjectionDigest'])
            || !existsAfter(/databases/$(database)/documents/publicSequences/$(sequenceId))
          );
      }

      // -------------------------------------------------------------------------
      // COMPOSITIONAL MODEL: Hand Paths (Tier 1) and Solo Props (Tier 2)
      // -------------------------------------------------------------------------
      // User-owned artifacts for the three-tier compositional sequence model.
      // Same ownership pattern as sequences.

      match /handPaths/{pathId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /soloProps/{soloPropId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // CHOREO SHEETS (Choreo module — printable sheet rosters)
      // -------------------------------------------------------------------------
      // Lightweight per-user docs: ordered sequence ids + layout + name. Written
      // by ChoreoSheetRepository (users/{uid}/choreoSheets). Private to the owner,
      // same pattern as handPaths/soloProps.
      match /choreoSheets/{sheetId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // TIKA CONVERSATIONS (AI Learning Assistant)
      // -------------------------------------------------------------------------
      match /tikaConversations/{conversationId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // TIKA INTERACTIONS (Topic Discussion Tracking)
      // -------------------------------------------------------------------------
      match /tikaInteractions/{topicId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // TIKA VERIFICATIONS (Server-side audit log)
      // -------------------------------------------------------------------------
      match /tikaVerifications/{verificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if false; // Immutable audit trail
        allow delete: if isAdmin();
      }

      // -------------------------------------------------------------------------
      // LEARNING PROGRESS (Concept Progress Tracking)
      // -------------------------------------------------------------------------
      match /learningProgress/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // PLAY PROGRESS (Arcade Personal Bests, Stars, Level Unlocks)
      // -------------------------------------------------------------------------
      match /playProgress/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // QUIZ HISTORY (Append-only Quiz Attempts)
      // -------------------------------------------------------------------------
      match /quizHistory/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false; // Quiz attempts are immutable
        allow delete: if isAdmin();
      }

      // -------------------------------------------------------------------------
      // VOICE SESSIONS (Voice Practice Data)
      // -------------------------------------------------------------------------
      match /voiceSessions/{sessionId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // TURN PATTERNS (Sequence Turn Pattern Templates)
      // -------------------------------------------------------------------------
      match /turnPatterns/{patternId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // ROTATION DIRECTION PATTERNS (Sequence Rotation Direction Templates)
      // -------------------------------------------------------------------------
      match /rotationDirectionPatterns/{patternId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // MANDALA COLLECTION (Saved mandala designs)
      // -------------------------------------------------------------------------
      match /mandala-collection/{mandalaId} {
        // Admin reads support user preview. Creates and updates stay owner-only.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();

        // Content-addressed private history, same contract as the tunnel one
        // below: the owner may create a revision and retry the identical
        // batch, but can never rewrite an existing payload in place.
        match /revisions/{revisionId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId)
            && request.resource.data.artifactType == 'mandala'
            && request.resource.data.artifactId == mandalaId
            && request.resource.data.revisionId == revisionId
            && revisionId == 'v1_' + request.resource.data.contentDigest
            && request.resource.data.contentDigest.matches('^[a-f0-9]{64}$')
            && request.resource.data.digestAlgorithm == 'SHA-256'
            && request.resource.data.digestVersion == 1;
          allow update: if isOwner(userId)
            && request.resource.data == resource.data;
          allow delete: if isAdmin();
        }
      }

      // -------------------------------------------------------------------------
      // TUNNEL COLLECTION (Saved tunnel snapshots — sequence + full look)
      // -------------------------------------------------------------------------
      match /tunnel-collection/{tunnelId} {
        // Admin reads support user preview. Creates and updates stay owner-only.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();

        // Content-addressed private history. Owner clients may create a
        // revision and may retry the exact same batch, but can never change an
        // existing payload in place. Administrative retention cleanup remains
        // possible without granting mutable history to the authoring client.
        match /revisions/{revisionId} {
          allow read: if isOwner(userId) || isAdmin();
          allow create: if isOwner(userId)
            && request.resource.data.artifactType == 'tunnel'
            && request.resource.data.artifactId == tunnelId
            && request.resource.data.revisionId == revisionId
            && revisionId == 'v1_' + request.resource.data.contentDigest
            && request.resource.data.contentDigest.matches('^[a-f0-9]{64}$')
            && request.resource.data.digestAlgorithm == 'SHA-256'
            && request.resource.data.digestVersion == 1;
          allow update: if isOwner(userId)
            && request.resource.data == resource.data;
          allow delete: if isAdmin();
        }
      }

      // -------------------------------------------------------------------------
      // 3D SCENE COLLECTION (Saved 3D viewer configs — scene + camera + performers)
      // -------------------------------------------------------------------------
      match /scene-3d-collection/{sceneId} {
        // Admin reads support user preview. Creates and updates stay owner-only.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // FILM COLLECTION (Saved film-director documents — scenes, cast, camera)
      // -------------------------------------------------------------------------
      match /film-collection/{filmId} {
        // Admin reads support user preview. Creates and updates stay owner-only.
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // -------------------------------------------------------------------------
      // FCM PUSH TOKENS (Device registration for push notifications)
      // -------------------------------------------------------------------------
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Owner-private profile data. Admin SDK migration and cleanup bypass
    // rules; browser access is limited to the account owner and signed admins.
    match /userPrivateProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'lastLocation', 'ageVerifiedAt',
          'attribution', 'googleId', 'googlePhotoURL', 'facebookId',
          'postHogSessionId', 'postHogSessionCapturedAt'
        ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================================
    // COLLECTIONS - User Collections for sequences, beats, etc.
    // ============================================================================

    // Collection-group read authorization: a PUBLIC collection is readable
    // wherever it lives. This is the rule that authorizes the discovery
    // collectionGroup("collections") query — which filters isPublic == true, so
    // the list is provably safe. A private collection (isPublic != true) is
    // granted nothing here, so a bare unfiltered collectionGroup query cannot
    // enumerate private collections; private reads fall through to the per-user
    // owner/admin rule below. A recursive-wildcard match is required for
    // collection-group queries (a nested-path rule only covers single-doc gets).
    match /{path=**}/collections/{collectionId} {
      allow read: if resource.data.isPublic == true;
    }

    // Public generator setups are readable wherever they live. This authorizes
    // the preset drawer's collectionGroup("generatorSetups") query, which
    // filters isPublic == true. A doc without the flag (legacy, pre-backfill)
    // is granted nothing here and falls through to the owner/admin rule.
    match /{path=**}/generatorSetups/{setupId} {
      allow read: if resource.data.isPublic == true;
    }

    // A recipient discovers only their own person-specific collection grants
    // through collectionGroup("shares"). The grant is a pointer; opening the
    // collection still passes the access check on the collection document.
    match /{path=**}/shares/{shareId} {
      allow read: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid;
    }

    // User Collections - PUBLIC collections are world-readable (via the
    // collection-group rule above). Private collections are readable by their
    // owner, an explicitly granted person, or an admin.
    match /users/{userId}/collections/{collectionId} {
      allow read: if resource.data.isPublic == true
        || isOwner(userId)
        || (isAuthenticated()
          && exists(/databases/$(database)/documents/users/$(userId)/collections/$(collectionId)/shares/$(request.auth.uid)))
        || isAdmin();

      // Publishing (the resulting doc has isPublic == true) requires a full
      // account — mirrors the isFullUser() gate publicSequences uses for its
      // public-write path, so there is one publish predicate shape across
      // the codebase. Firestore's update semantics carry unchanged fields
      // into request.resource.data, so this also covers "already public,
      // editing" (isPublic stays true) without a separate resource.data
      // check. Private creates/edits and un-publishing (isPublic -> false)
      // stay open to guests, same as the rest of the guest-tier
      // "play/save is open" surface — the un-publish case always evaluates
      // request.resource.data.isPublic != true and is never blocked.
      allow create: if isOwner(userId)
        && (request.resource.data.isPublic != true || isFullUser());

      // Owners retain the existing publish gate. Editors may change only the
      // shared collection's presentation. Membership goes through the callable
      // so sequence ownership and public/private visibility are validated.
      // Access, ownership, public state, system markers, and deletion stay
      // owner-only.
      allow update: if (isOwner(userId)
          && (request.resource.data.isPublic != true || isFullUser()))
        || (isAuthenticated()
          && get(/databases/$(database)/documents/users/$(userId)/collections/$(collectionId)/shares/$(request.auth.uid)).data.role == 'editor'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'credit', 'coverImageUrl', 'color', 'icon', 'updatedAt'
          ]));

      // Deleting never publishes anything; owner-only regardless of isPublic.
      allow delete: if isOwner(userId);

      // Cross-account grants are written by callable functions after owner and
      // conversation validation. Clients can read their own grant or, as the
      // collection owner, list everyone who has access.
      match /shares/{recipientId} {
        allow read: if isOwner(userId)
          || (isAuthenticated() && request.auth.uid == recipientId)
          || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // Followed collections - lightweight pointers to other users' public
    // collections (users/{uid}/followedCollections/{ownerId}_{collectionId}).
    // Private to the follower; the pointed-at collection is already
    // world-readable above.
    match /users/{userId}/followedCollections/{followId} {
      allow read, write: if isOwner(userId);
    }

    // Sequences within collections - public sequences world-readable, private
    // ones owner/admin-only (mirrors the primary users/{uid}/sequences rule).
    match /users/{userId}/collections/{collectionId}/sequences/{sequenceId} {
      allow read: if resource.data.visibility == 'public'
        || isOwner(userId)
        || isAdmin();

      // Only the owner can create/update/delete their sequences
      allow create, update, delete: if isOwner(userId);
    }

    // Legacy root-level sequences path. The live app writes/reads
    // users/{uid}/sequences exclusively (grep across src/, scripts/,
    // functions/, api/ on 2026-07-19 found zero writers of collection(db,
    // "sequences") at root). One live READER remains: the admin "preview
    // another user" debug tool
    // (src/lib/shared/debug/state/user-preview-state.svelte.ts fetchSequences,
    // wired into the isAdmin()-gated AdminToolbar), which queries this path
    // filtered by createdBy — so the block is tightened, not deleted, and
    // gains an isPublic read gate instead of the previous unconditional
    // `allow read: if true` (which let anyone read ANY sequence here,
    // public or private, by id).
    match /sequences/{sequenceId} {
      allow read: if resource.data.isPublic == true
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || isAdmin();

      // Only a full-account creator can write here (mirrors the isFullUser()
      // gate used everywhere else public/legacy content can be created).
      allow create: if isFullUser() && hasValidUserId();
      allow update, delete: if isFullUser()
        && resource.data.userId == request.auth.uid;
    }

    // Legacy root-level /collections block DELETED 2026-07-19. Grep across
    // src/, scripts/, functions/, api/, __/ for collection(db, "collections")
    // / db.collection("collections") at root found zero readers or writers —
    // the app's only "collections" access is the per-user subcollection
    // (users/{uid}/collections, ruled above) and the users/{uid}/collections
    // collection-group rule. See the security-hardening spec at
    // docs/superpowers/specs/active/2026-07-18-onboarding-firestore-security.md
    // for the grep evidence.

    // ============================================================================
    // MESSAGING COLLECTIONS
    // ============================================================================

    // Check if user is a participant in a conversation (or admin for preview mode)
    function isConversationParticipant(conversationId) {
      let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return isAuthenticated() && (request.auth.uid in conv.participants || isAdmin());
    }

    // Conversations - only participants can read/write
    // Supports both direct (1:1) and group conversations
    // Admins can read any conversation for impersonation/preview mode
    match /conversations/{conversationId} {
      // Participants can read their conversations, admins can read any (for preview mode)
      allow read: if isAuthenticated()
        && (request.auth.uid in resource.data.participants || isAdmin());

      // Creating a conversation - user must be in participants list OR be admin (for impersonation)
      // Direct (1:1): exactly 2 participants, type must be "direct" or missing
      // Groups: 2-50 participants, type must be "group", creator must be admin
      allow create: if isFullUser()
        && (request.auth.uid in request.resource.data.participants || isAdmin())
        && (
          // Direct conversations (existing behavior, backward compatible)
          ((!('type' in request.resource.data) || request.resource.data.type == 'direct')
            && request.resource.data.participants.size() == 2)
          ||
          // Group conversations (new)
          (request.resource.data.type == 'group'
            && request.resource.data.participants.size() >= 2
            && request.resource.data.participants.size() <= 50
            && request.auth.uid in request.resource.data.groupMetadata.adminIds
            && request.auth.uid == request.resource.data.groupMetadata.createdBy)
        );

      // Updating - participants can update their conversations
      // Direct: cannot change participant list
      // Groups: standard updates by participants, membership changes by admins only
      allow update: if isFullUser()
        && request.auth.uid in resource.data.participants
        && (
          // Direct conversations: membership and document shape stay fixed
          ((!('type' in resource.data) || resource.data.type == 'direct')
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['unreadCount', 'lastMessage', 'updatedAt', 'typing', 'participantInfo', 'archived']))
          ||
          // Group conversations: standard updates or admin membership changes
          (resource.data.type == 'group' && (
            // Standard updates (unread, lastMessage, typing, updatedAt)
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['unreadCount', 'lastMessage', 'updatedAt', 'typing'])
            ||
            // Admin-only updates (participants, groupMetadata)
            request.auth.uid in resource.data.groupMetadata.adminIds
          ))
        );

      // No deleting conversations (soft delete via flag if needed)
      allow delete: if false;

      // Messages subcollection - only participants can read/write
      match /messages/{messageId} {
        function hasValidClientAttachment() {
          return !('attachments' in request.resource.data)
            || request.resource.data.attachments == null
            || (request.resource.data.attachments is list
              && request.resource.data.attachments.size() <= 1
              && request.resource.data.attachments.size() > 0
              && request.resource.data.attachments[0].type in ['sequence', 'link', 'feedback']);
        }

        function hasValidMessageBody() {
          return request.resource.data.content is string
            && request.resource.data.content.size() <= 2000
            && (request.resource.data.content.size() > 0
              || (request.resource.data.attachments is list
                && request.resource.data.attachments.size() > 0));
        }

        function isValidReplyPreview(reply) {
          let targetPath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(reply.messageId);
          let target = get(targetPath).data;

          return reply.keys().hasOnly([
              'messageId',
              'senderId',
              'senderName',
              'content',
              'attachmentType'
            ])
            && reply.keys().hasAll([
              'messageId',
              'senderId',
              'senderName',
              'content'
            ])
            && reply.messageId is string
            && reply.messageId != messageId
            && reply.senderId is string
            && reply.senderName is string
            && reply.senderName.size() > 0
            && reply.senderName.size() <= 120
            && reply.content is string
            && reply.content.size() <= 2000
            && exists(targetPath)
            && target.senderId == reply.senderId
            && target.senderName == reply.senderName
            && target.content == reply.content
            && (!('isDeleted' in target) || target.isDeleted == false)
            && (
              (!('attachmentType' in reply)
                && (!('attachments' in target)
                  || target.attachments == null
                  || target.attachments.size() == 0))
              ||
              ('attachmentType' in reply
                && reply.attachmentType in ['image', 'sequence', 'collection', 'link', 'feedback']
                && target.attachments is list
                && target.attachments.size() > 0
                && target.attachments[0].type == reply.attachmentType)
            );
        }

        function hasValidReplyPreview() {
          return !('replyTo' in request.resource.data)
            || request.resource.data.replyTo == null
            || (request.resource.data.replyTo is map
              && isValidReplyPreview(request.resource.data.replyTo));
        }

        function isValidMessageEdit() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let oldHistory = ('editHistory' in resource.data
              && resource.data.editHistory is list)
            ? resource.data.editHistory
            : [];
          let newHistory = ('editHistory' in request.resource.data)
            ? request.resource.data.editHistory
            : [];
          let appendedIndex = oldHistory.size();

          return resource.data.senderId == request.auth.uid
            && (!('isDeleted' in resource.data) || resource.data.isDeleted == false)
            && changed.hasOnly(['content', 'editedAt', 'editHistory'])
            && changed.hasAll(['content', 'editedAt', 'editHistory'])
            && request.resource.data.content != resource.data.content
            && hasValidMessageBody()
            && request.resource.data.editedAt is timestamp
            && newHistory is list
            && newHistory.size() == oldHistory.size() + 1
            && (oldHistory.size() == 0
              || newHistory[0:appendedIndex] == oldHistory)
            && newHistory[appendedIndex] is map
            && newHistory[appendedIndex].keys().hasOnly(['content', 'editedAt'])
            && newHistory[appendedIndex].content == resource.data.content
            && newHistory[appendedIndex].editedAt is timestamp;
        }

        function isValidMessageDelete() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();

          return resource.data.senderId == request.auth.uid
            && (!('isDeleted' in resource.data) || resource.data.isDeleted == false)
            && changed.hasOnly(['content', 'isDeleted'])
            && changed.hasAll(['content', 'isDeleted'])
            && request.resource.data.isDeleted == true
            && request.resource.data.content == '[Message deleted]';
        }

        // Only participants of parent conversation can read messages
        allow read: if isConversationParticipant(conversationId);

        // Creating messages - must be sender and a participant
        allow create: if isFullUser()
          && isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && hasValidClientAttachment()
          && hasValidMessageBody()
          && hasValidReplyPreview();

        // Updating messages:
        // - Sender edits append the previous text to immutable edit history
        // - Sender soft-deletes use the fixed tombstone text
        // - Any participant can update reactions or read status
        allow update: if isConversationParticipant(conversationId)
          && (isValidMessageEdit()
              || isValidMessageDelete()
              || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions', 'readBy', 'readAt']));

        // No hard deleting messages (soft delete via isDeleted flag)
        allow delete: if false;
      }
    }

    // ============================================================================
    // STRIPE SUBSCRIPTION COLLECTIONS
    // Firebase Stripe Extension manages these collections
    // ============================================================================

    // Customer data - managed by Stripe extension
    match /customers/{uid} {
      // Users can only read their own customer data
      allow read: if isOwner(uid);
      // Extension writes this data via admin SDK (no client writes)
      allow write: if false;

      // Checkout sessions - created by client, processed by extension
      match /checkout_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      // Subscriptions - managed by extension webhooks
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Payment methods - managed by extension
      match /payments/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Products catalog - public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Price tiers for each product
      match /prices/{priceId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============================================================================
    // PRESENCE TRACKING
    // ============================================================================

    // Presence collection - tracks user online status
    match /presence/{userId} {
      // Anyone authenticated can read presence (for showing online status)
      allow read: if isAuthenticated();
      // Users can write their own presence
      allow create, update: if isOwner(userId);
      // Users can delete their own, admins can delete any (for user cleanup)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================================
    // ACTIVITY LOGGING
    // ============================================================================

    // Activity log - users can read their own, admins can read all
    // Events are append-only (no update/delete by users, admins can delete for cleanup)
    match /users/{userId}/activityLog/{eventId} {
      // Users can read their own activity, admins can read anyone's
      allow read: if isOwner(userId) || isAdmin();

      // Only the owner can create events in their own log
      allow create: if isOwner(userId);

      // Events are immutable for users, but admins can delete for cleanup
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Personal Museum - a user's curated wall-slot placements (single doc "main").
    // Private to the owner in the MVP; an isPublic flag exists for a future
    // "others can visit" phase, at which point a public-read clause can be added.
    match /users/{userId}/personal-museum/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================================================
    // CONTRIBUTORS COLLECTION (Release Notes Attribution)
    // ============================================================================

    // Curated list of developers credited in release notes.
    // Each doc references a user account (userId field).
    // Anyone authenticated can read (badges shown in What's New modal).
    // Only admins can add/remove contributors.
    match /contributors/{contributorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================================
    // VERSIONS COLLECTION (Release Management)
    // ============================================================================

    // App versions - publicly readable, only admins can write.
    // Version docs are user-facing release notes / changelog (What's New),
    // meant for everyone including guests and anonymous sessions. Same
    // non-sensitive class as config/featureFlags above. Previously gated to
    // isTester(), which threw permission-denied for guests on load.
    match /versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================================
    // FEEDBACK COLLECTION
    // ============================================================================

    // Feedback items - users can submit and read their own, testers/admins/developers can manage
    match /feedback/{feedbackId} {
      // Users can read their own feedback, testers/admins can read all
      // Any authenticated user can read (for developer CLI access)
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTester() || isApprovedDeveloper());

      // Any authenticated user can submit feedback (must set their own userId)
      allow create: if isFullUser()
        && request.resource.data.userId == request.auth.uid;

      // Testers/admins OR approved developers can update feedback
      allow update: if isTester() || isApprovedDeveloper();

      // Admins can delete any feedback; contributors can delete their own
      allow delete: if isAdmin() || isDeveloperAdmin()
        || (isContributor() && resource.data.userId == request.auth.uid);

      // Subtasks subcollection
      match /subtasks/{subtaskId} {
        allow read: if isTester();
        allow write: if isTester();
      }

      // Journal subcollection (append-only activity log from CLI)
      match /journal/{entryId} {
        allow read: if isTester() || isApprovedDeveloper();
        allow create: if isTester() || isApprovedDeveloper();
        allow update, delete: if isAdmin();
      }
    }

    // ============================================================================
    // COLLABORATIVE VIDEOS
    // ============================================================================

    // Videos collection - for collaborative video uploads
    // Public videos support signed-in discovery. Private videos stay with their
    // creator; collaborator rosters grant reads only in collaborators-only mode.
    match /videos/{videoId} {
      function visibility(data) {
        return data.get('visibility', 'private');
      }

      function collaboratorIds(data) {
        return data.get('collaboratorIds', []);
      }

      function pendingInviteUserIds(data) {
        return data.get('pendingInviteUserIds', []);
      }

      function hasValidVisibility(data) {
        return visibility(data) in ['public', 'private', 'collaborators-only'];
      }

      allow read: if isAuthenticated()
        && (
          visibility(resource.data) == 'public'
          || resource.data.creatorId == request.auth.uid
          || (
            visibility(resource.data) == 'collaborators-only'
            && request.auth.uid in collaboratorIds(resource.data)
          )
          // Invite recipients need the record in order to accept or decline.
          || request.auth.uid in pendingInviteUserIds(resource.data)
        );

      // Only creator can create
      allow create: if isFullUser()
        && request.resource.data.creatorId == request.auth.uid
        && hasValidVisibility(request.resource.data);

      // The creator controls publishing and descriptive metadata. Collaborators
      // and invite recipients can change only collaboration data and beat maps.
      allow update: if isAuthenticated()
        && request.resource.data.creatorId == resource.data.creatorId
        && hasValidVisibility(request.resource.data)
        && (
          resource.data.creatorId == request.auth.uid
          || (
            (
              request.auth.uid in collaboratorIds(resource.data)
              || request.auth.uid in pendingInviteUserIds(resource.data)
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'beatMap',
              'collaborators',
              'collaboratorIds',
              'pendingInvites',
              'pendingInviteUserIds',
              'updatedAt'
            ])
          )
        );

      // Only creator can delete
      allow delete: if isAuthenticated()
        && resource.data.creatorId == request.auth.uid;
    }

    // ============================================================================
    // QR CODE SHORT CODES
    // ============================================================================

    // Short codes for QR code URLs - maps 6-char codes to encoded sequences
    // Public read so anyone can scan QR codes and resolve them
    // Authenticated users can create new codes
    match /shortcodes/{code} {
      // ANYONE can read short codes (QR scanning works without auth)
      allow read: if true;

      // Strict immutable mint contract:
      //   - schema 2 is a payload-derived two-hand word;
      //   - schema 3 is titled solo choreography with no invented word.
      // Each branch requires its own durable payload shape. A mint carrying an
      // encoderHash must write its shortcodeHashes claim in the same
      // transaction (allocateCode's shape); hash-less schema-2 fallback mints
      // carry no claim.
      allow create: if isFullUser()
        && (isValidWordShortcodeMint() || isValidSoloShortcodeMint())
        && (
          !request.resource.data.keys().hasAny(['encoderHash'])
          || (
            request.resource.data.encoderHash is string
            && request.resource.data.encoderHash.size() == 64
            && getAfter(/databases/$(database)/documents/shortcodeHashes/$(request.resource.data.encoderHash)).data.get('code', '') == code
          )
        );

      // Scan counters are updated only by the server-owned ingestion endpoint.
      // Client-side increments made this field trivially inflatable.
      allow update: if isAdmin();

      // No deletion - short codes are permanent
      allow delete: if isAdmin();

      // Scan event log — scoped creation under shortcodes only.
      // The collectionGroup read rule above covers admin live-feed queries.
      match /scanEvents/{eventId} {
        // Service-account writes bypass rules; browsers cannot manufacture
        // events or spoof geo/device attribution.
        allow create: if false;
        allow read: if isAdmin();
        allow update, delete: if false;
      }

      // Historical journey projections are retained as private source data.
      // Public maps are derived only after a card has enough meaningful history.
      match /journeyPoints/{pointId} {
        allow create: if false;
        allow read: if isAdmin();
        allow update, delete: if false;
      }
    }

    // Server-issued physical artwork inventory. These collections contain
    // provenance, recipient placeholders, and scan counters; they are not a
    // browser-writable or public collector surface.
    match /cardPrintRuns/{runId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /physicalCards/{physicalCardId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Content-addressed shortcode index: one code per encoderHash.
    // Written atomically with the code doc inside the allocation transaction
    // (see 2026-07-05 shortcode-dup-mint-fix spec). Immutable after create —
    // first writer wins; the transaction's loser adopts the winner's code.
    match /shortcodeHashes/{hash} {
      // Public read: resolution paths and the allocation pre-check may run
      // before auth resolves; the mapping contains no PII.
      allow read: if true;

      // PHASE 4 (2026-07-27): a claim may only name a code whose document
      // exists after the same transaction and carries THIS encoderHash — the
      // allocateCode transaction's shape. The resolution-time heal path
      // (healHashIndex) also satisfies this against an existing code doc; a
      // legacy code doc without an encoderHash field is unverifiable, so its
      // heal is denied and absorbed by the heal's try/catch, which is the
      // honest outcome — never index an unproven mapping.
      allow create: if isFullUser()
        && request.resource.data.keys().hasOnly(['code', 'createdAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4
        && request.resource.data.code.size() <= 6
        && existsAfter(/databases/$(database)/documents/shortcodes/$(request.resource.data.code))
        && getAfter(/databases/$(database)/documents/shortcodes/$(request.resource.data.code)).data.get('encoderHash', '') == hash;

      allow update, delete: if isAdmin();
    }

    // Scan event log — collectionGroup read-only for admin live feed.
    // Creation is only allowed under shortcodes/{code}/scanEvents (see below).
    match /{path=**}/scanEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================================================
    // PUBLIC SEQUENCES INDEX
    // ============================================================================

    // A schema-2 public projection must prove the publish-transaction shape:
    // provenance pointing at the caller's own owner document, the identity
    // pair, the projection stamps, and a hash claim that exists AFTER the
    // transaction and names this sequence. Rules cannot recompute a SHA-256
    // digest — equality of the stamps guards accidental drift; the shared
    // builder and the parity audit guard the full projection
    // (parity-repair spec, section 9).
    // Every field access uses .get() with a failing default: a missing field
    // must evaluate to FALSE (deny), never to an evaluation error — an error
    // in any operand can poison the whole condition in the rules engine.
    //
    // PHASE 4 (2026-07-27): the getAfter() linkage proofs are LIVE. The
    // emulator defect that deferred them (firebase-tools 14.23.0 failed ALL
    // getAfter calls — issues #2983/#2067 class, bisect 2026-07-26) is fixed
    // in firebase-tools 15.24.0, proven by
    // tests/integration/firestore-rules/getafter-probe.rules.test.ts. Every
    // public write now requires the full publish-transaction shape: schema-2
    // fields, the owner document in parity AFTER the transaction, and the
    // content-hash claim naming this sequence AFTER the transaction. The
    // legacy-shape allowance is removed — an old cached client fails its
    // public cloud sync (typed as a client-version failure app-side) instead
    // of creating drift. Reads stay tolerant.
    function isValidSchemaTwoPublicWrite(sequenceId) {
      let d = request.resource.data;
      return d.get('sourceRef', '') == 'users/' + request.auth.uid + '/sequences/' + sequenceId
        && d.get('contentHash', '') is string
        && d.get('contentHash', '').size() == 64
        && d.get('contentHashVersion', -1) is int
        && d.get('contentHashVersion', -1) >= 0
        && d.get('word', '') is string
        && d.get('word', '').size() > 0
        && d.get('sequenceLength', 0) is int
        && d.get('sequenceLength', 0) > 0
        && d.get('publicProjectionRevision', -1) is int
        && d.get('publicProjectionDigest', '') is string
        && d.get('publicProjectionDigest', '').size() > 0;
    }

    // The public document's owner source must exist after the transaction,
    // still be published, and agree on every core field rules can compare
    // directly (section 9). The publish and thumbnail transactions stamp the
    // owner document in the same commit, so honest writes always satisfy
    // this; a public write with no paired owner write only passes when the
    // stored owner document already matches.
    function publicOwnerParityAfter(sequenceId) {
      let d = request.resource.data;
      let ownerPath = /databases/$(database)/documents/users/$(request.auth.uid)/sequences/$(sequenceId);
      return existsAfter(ownerPath)
        && getAfter(ownerPath).data.get('visibility', '') == 'public'
        && getAfter(ownerPath).data.get('publicProjectionRevision', -1) == d.get('publicProjectionRevision', -2)
        && getAfter(ownerPath).data.get('publicProjectionSchemaVersion', -1) == d.get('publicProjectionSchemaVersion', -2)
        && getAfter(ownerPath).data.get('publicProjectionDigest', '') == d.get('publicProjectionDigest', '?')
        && getAfter(ownerPath).data.get('word', '') == d.get('word', '?')
        && getAfter(ownerPath).data.get('contentHash', '') == d.get('contentHash', '?')
        && getAfter(ownerPath).data.get('contentHashVersion', -1) == d.get('contentHashVersion', -2)
        && getAfter(ownerPath).data.get('sequenceLength', -1) == d.get('sequenceLength', -2);
    }

    // The content-hash claim for the written document's hash pair must exist
    // after the transaction and name this sequence and caller — either
    // pre-existing (republish of unchanged content) or written in the same
    // commit (first publication, claim self-heal).
    function publicClaimAfter(sequenceId) {
      let d = request.resource.data;
      let claimPath = /databases/$(database)/documents/publicSequenceHashes/$(string(d.get('contentHashVersion', -1)) + '_' + d.get('contentHash', ''));
      return existsAfter(claimPath)
        && getAfter(claimPath).data.get('sequenceId', '') == sequenceId
        && getAfter(claimPath).data.get('ownerId', '') == request.auth.uid;
    }

    // An owner-document write that touches the projection stamps proves the
    // paired transaction: stamps present after the write → the public mirror
    // exists after the transaction in full parity; stamps removed → the
    // mirror is gone with them (unpublish shape).
    function ownerStampWriteProven(userId, sequenceId) {
      return request.resource.data.keys().hasAny(['publicProjectionDigest'])
        ? ownerStampParityAfter(userId, sequenceId)
        : !existsAfter(/databases/$(database)/documents/publicSequences/$(sequenceId));
    }

    function ownerStampParityAfter(userId, sequenceId) {
      let d = request.resource.data;
      let pubPath = /databases/$(database)/documents/publicSequences/$(sequenceId);
      return existsAfter(pubPath)
        && getAfter(pubPath).data.get('ownerId', '') == userId
        && getAfter(pubPath).data.get('sourceRef', '') == 'users/' + userId + '/sequences/' + sequenceId
        && getAfter(pubPath).data.get('publicProjectionRevision', -1) == d.get('publicProjectionRevision', -2)
        && getAfter(pubPath).data.get('publicProjectionSchemaVersion', -1) == d.get('publicProjectionSchemaVersion', -2)
        && getAfter(pubPath).data.get('publicProjectionDigest', '') == d.get('publicProjectionDigest', '?')
        && getAfter(pubPath).data.get('word', '') == d.get('word', '?')
        && getAfter(pubPath).data.get('contentHash', '') == d.get('contentHash', '?')
        && getAfter(pubPath).data.get('contentHashVersion', -1) == d.get('contentHashVersion', -2)
        && getAfter(pubPath).data.get('sequenceLength', -1) == d.get('sequenceLength', -2);
    }

    // A deleted public document must not leave its own claim behind: the
    // stored hash pair's claim is gone after the transaction, or it belongs
    // to a different sequence (a stale mirror's claim is not this document's
    // to remove). Legacy documents without a hash pair carry no claim.
    function publicClaimReleasedAfterDelete(sequenceId) {
      let hash = resource.data.get('contentHash', '');
      let version = resource.data.get('contentHashVersion', -1);
      let claimPath = /databases/$(database)/documents/publicSequenceHashes/$(string(version) + '_' + hash);
      return hash == ''
        || !existsAfter(claimPath)
        || getAfter(claimPath).data.get('sequenceId', '') != sequenceId;
    }

    // Public sequences - denormalized for Browse page browsing
    match /publicSequences/{sequenceId} {
      // ANYONE can read public sequences (no authentication required)
      // See documentation at top of file for security rationale
      allow read: if true;

      // Only the owner can write (via sync from their private library).
      // PHASE 4 STRICT (2026-07-27): the legacy-shape allowance is removed.
      // Every write must be schema 2 and prove the full publish-transaction
      // shape — field shape, owner parity after the transaction, and the
      // hash claim after the transaction. An old cached client now fails its
      // public cloud sync instead of creating drift.
      allow create: if isFullUser()
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('publicPerformanceCount', 0) == 0
        && !request.resource.data.keys().hasAny(['latestPublicPerformanceAt'])
        && request.resource.data.get('publicProjectionSchemaVersion', 0) == 2
        && isValidSchemaTwoPublicWrite(sequenceId)
        && publicOwnerParityAfter(sequenceId)
        && publicClaimAfter(sequenceId);
      // Update additionally requires owning the EXISTING document. Checking
      // only the incoming ownerId let any full user hijack any public doc by
      // overwriting it with their own uid — a hole the parity rules tests
      // exposed in the original block (2026-07-26).
      allow update: if isFullUser()
        && resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('ownerId', '') == request.auth.uid
        // Public-performance discovery is reconciled by Admin triggers. An
        // owner republish may preserve these fields, never forge or erase them.
        && request.resource.data.get('publicPerformanceCount', 0)
          == resource.data.get('publicPerformanceCount', 0)
        && request.resource.data.get('latestPublicPerformanceAt', null)
          == resource.data.get('latestPublicPerformanceAt', null)
        && request.resource.data.get('publicProjectionSchemaVersion', 0) == 2
        && isValidSchemaTwoPublicWrite(sequenceId)
        && publicOwnerParityAfter(sequenceId)
        && publicClaimAfter(sequenceId);
      // Owner, or an admin running the client-side labeler/repair tooling
      // through the unpublish transaction. Owner check FIRST: `||`
      // error-absorbs, so a profile-less user's isAdmin() get() error still
      // denies instead of erroring the whole rule. Phase 4: the delete must
      // not strand the document's own hash claim (unpublish shape).
      allow delete: if ((isAuthenticated()
        && resource.data.get('ownerId', '') == request.auth.uid)
        || isAdmin())
        && publicClaimReleasedAfterDelete(sequenceId);
    }

    // Immutable, media-eligible snapshots of public sequence subjects. The
    // client publication transaction may create the retained snapshot only
    // when the matching public projection exists after that same transaction.
    // Once written, a revision is never edited or deleted by clients.
    match /sequenceRevisions/{revisionId} {
      allow get: if isAuthenticated() || (
        resource.data.get('sequenceId', '') is string
        && exists(/databases/$(database)/documents/publicSequences/$(resource.data.sequenceId))
      );
      allow list: if isAdmin();

      allow create: if isFullUser()
        && request.resource.data.get('subjectType', '') == 'sequence'
        && request.resource.data.get('sequenceId', '') is string
        && request.resource.data.get('sequenceId', '').size() > 0
        && request.resource.data.get('artifactId', '') == request.resource.data.sequenceId
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('revisionId', '') == revisionId
        && revisionId == 'v1_' + request.resource.data.contentDigest
        && revisionId.matches('^v1_[a-f0-9]{64}$')
        && request.resource.data.get('contentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('digestAlgorithm', '') == 'SHA-256'
        && request.resource.data.get('digestVersion', 0) == 1
        && request.resource.data.get('publicationState', '') == 'public'
        && request.resource.data.get('contentHash', '').size() == 64
        && existsAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId))
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('ownerId', '') == request.auth.uid
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('contentHash', '') == request.resource.data.contentHash
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('contentHashVersion', -1) == request.resource.data.contentHashVersion;

      allow update, delete: if false;
    }

    // Content-addressed public-sequence identity claims: ONE claim per
    // distinct movement, keyed {contentHashVersion}_{contentHash} so hash
    // bases can never mix. Written atomically with the public projection
    // inside the publish transaction (public-sequence-persister.ts) — the
    // same first-writer-wins pattern as shortcodeHashes above, except a
    // losing publisher cannot adopt another owner's sequence id, so it gets
    // a typed PUBLIC_DUPLICATE instead of a code to reuse.
    match /publicSequenceHashes/{claimId} {
      // Public read: duplicate detection runs before publish UI decisions,
      // and the mapping contains no PII.
      allow read: if true;

      // PHASE 4 (2026-07-27): a claim may only be created when the public
      // document it names exists after the same transaction and carries this
      // exact hash pair — the publish transaction's shape (and the thumbnail
      // path's claim self-heal). A standalone claim naming content that is
      // not actually published is unwritable.
      allow create: if isFullUser()
        && request.resource.data.keys().hasOnly(['sequenceId', 'ownerId', 'contentHash', 'contentHashVersion', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sequenceId is string
        && request.resource.data.sequenceId.size() > 0
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.size() == 64
        && request.resource.data.contentHashVersion is int
        && claimId == string(request.resource.data.contentHashVersion) + '_' + request.resource.data.contentHash
        && existsAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId))
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('contentHash', '') == request.resource.data.contentHash
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('contentHashVersion', -1) == request.resource.data.contentHashVersion
        && getAfter(/databases/$(database)/documents/publicSequences/$(request.resource.data.sequenceId)).data.get('ownerId', '') == request.resource.data.ownerId;

      // The identity mapping is immutable — a claim moves only by delete +
      // re-create inside a transaction that proves ownership.
      allow update: if false;

      // Released by its owner (unpublish, delete, or content-hash change,
      // proven inside the transaction), or by an admin running the
      // client-side labeler/repair tooling through the same transaction.
      // Owner check FIRST so a profile-less user's isAdmin() get() error
      // absorbs to deny rather than erroring the rule. Server-side repair
      // uses the Admin SDK, which bypasses rules entirely.
      // PHASE 4: the release must be PROVEN — after the transaction the
      // named public document is gone (unpublish/delete) or carries a
      // DIFFERENT hash pair (content-hash change releasing the stale claim).
      allow delete: if ((isAuthenticated()
        && resource.data.get('ownerId', '') == request.auth.uid)
        || isAdmin())
        && (
          !existsAfter(/databases/$(database)/documents/publicSequences/$(resource.data.get('sequenceId', '')))
          || getAfter(/databases/$(database)/documents/publicSequences/$(resource.data.get('sequenceId', ''))).data.get('contentHash', '') != resource.data.get('contentHash', '')
          || getAfter(/databases/$(database)/documents/publicSequences/$(resource.data.get('sequenceId', ''))).data.get('contentHashVersion', -1) != resource.data.get('contentHashVersion', -1)
        );
    }

    // ============================================================================
    // VISUAL ARTIFACT PUBLICATION (Browse Phase 3 — tunnels first)
    //
    // PUBLISH-FIRST model (docs/superpowers/specs/active/
    // 2026-08-23-phase3-tunnel-publication-plan.md): sharing goes live the
    // moment the owner publishes; moderation is a retroactive takedown, not a
    // gate. Four-resource boundary:
    //   - the private mutable work stays under users/{uid}/... (rules above);
    //   - artifactPublicationRequests/{artifactId}_{revisionId} is the
    //     append-only publication ledger (owner/admin only);
    //   - publicArtifacts/{artifactId} is the guest envelope, which exists ONLY
    //     while live — created by the owner's publish batch, deleted by owner
    //     withdrawal or admin takedown;
    //   - publicArtifacts/{artifactId}/revisions/{revisionId} are immutable
    //     content-addressed sanitized payloads; guests may read them only while
    //     the envelope exists, so delisting cascades without deleting history.
    // Saving is never publishing; publishing is an explicit owner batch whose
    // shape the rules verify field by field. Content taken down by moderation
    // (`removed`) can never be republished by its owner as-is.
    // ============================================================================

    match /publicArtifacts/{artifactId} {
      // ANYONE can read: the envelope exists only in live state.
      allow read: if true;

      // Created by the owner's publish batch (or an admin repair), and only in
      // the live shape: content-addressed current revision that exists after
      // this same transaction, with the matching ledger entry published after
      // this same transaction and owned by the envelope's owner. Non-admins
      // must stamp publishedAt with the server time (no backdating the
      // newest-first Explore sort).
      allow create: if (isAdmin()
          || (isFullUser()
            && request.resource.data.get('ownerId', '') == request.auth.uid
            && request.resource.data.get('publishedAt', 0) == request.time))
        && request.resource.data.keys().hasOnly(['artifactId', 'artifactType', 'ownerId', 'ownerDisplayName', 'title', 'posterUrl', 'currentRevisionId', 'currentContentDigest', 'publishedAt', 'updatedAt', 'schemaVersion'])
        && request.resource.data.get('artifactId', '') == artifactId
        && request.resource.data.get('artifactType', '') in ['tunnel', 'mandala', 'scene']
        && request.resource.data.get('ownerId', '').size() > 0
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('currentContentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('currentRevisionId', '') == 'v1_' + request.resource.data.currentContentDigest
        && existsAfter(/databases/$(database)/documents/publicArtifacts/$(artifactId)/revisions/$(request.resource.data.currentRevisionId))
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + request.resource.data.currentRevisionId)).data.get('status', '') == 'published'
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + request.resource.data.currentRevisionId)).data.get('ownerId', '') == request.resource.data.ownerId;

      // Publishing a NEW revision of an already-live artifact: same shape and
      // same-transaction proofs, plus frozen identity (owner, type, original
      // publishedAt survive across revisions).
      allow update: if (isAdmin()
          || (isFullUser() && resource.data.get('ownerId', '') == request.auth.uid))
        && request.resource.data.keys().hasOnly(['artifactId', 'artifactType', 'ownerId', 'ownerDisplayName', 'title', 'posterUrl', 'currentRevisionId', 'currentContentDigest', 'publishedAt', 'updatedAt', 'schemaVersion'])
        && request.resource.data.get('artifactId', '') == artifactId
        && request.resource.data.get('artifactType', '') == resource.data.get('artifactType', '')
        && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '')
        && request.resource.data.get('publishedAt', 0) == resource.data.get('publishedAt', 1)
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('currentContentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('currentRevisionId', '') == 'v1_' + request.resource.data.currentContentDigest
        && existsAfter(/databases/$(database)/documents/publicArtifacts/$(artifactId)/revisions/$(request.resource.data.currentRevisionId))
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + request.resource.data.currentRevisionId)).data.get('status', '') == 'published'
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + request.resource.data.currentRevisionId)).data.get('ownerId', '') == request.resource.data.ownerId;

      // Withdrawal (owner) or removal (admin) deletes the envelope, delisting
      // the artifact. Owner check FIRST: `||` error-absorbs, so a profile-less
      // user's isAdmin() error still denies instead of erroring the rule.
      allow delete: if (isAuthenticated()
          && resource.data.get('ownerId', '') == request.auth.uid)
        || isAdmin();
    }

    match /publicArtifacts/{artifactId}/revisions/{revisionId} {
      // Guests read a revision only while the parent envelope exists (approved
      // state). The owner and admins can always resolve history — media that
      // pinned a revision must stay explainable after a withdrawal.
      allow get: if isAdmin()
        || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid)
        || exists(/databases/$(database)/documents/publicArtifacts/$(artifactId));
      allow list: if isAdmin()
        || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid);

      // Created inside the owner's publish batch (or by an admin repair),
      // content-addressed over the sanitized public payload, with parity
      // against the ledger entry being published in the same transaction.
      allow create: if (isAdmin()
          || (isFullUser()
            && request.resource.data.get('ownerId', '') == request.auth.uid))
        && request.resource.data.keys().hasOnly(['artifactId', 'revisionId', 'contentDigest', 'digestAlgorithm', 'digestVersion', 'artifactType', 'ownerId', 'payload', 'createdAt', 'schemaVersion'])
        && request.resource.data.get('artifactId', '') == artifactId
        && request.resource.data.get('revisionId', '') == revisionId
        && revisionId == 'v1_' + request.resource.data.get('contentDigest', '')
        && revisionId.matches('^v1_[a-f0-9]{64}$')
        && request.resource.data.get('contentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('digestAlgorithm', '') == 'SHA-256'
        && request.resource.data.get('digestVersion', 0) == 1
        && request.resource.data.get('artifactType', '') in ['tunnel', 'mandala', 'scene']
        && request.resource.data.get('ownerId', '').size() > 0
        && request.resource.data.get('schemaVersion', 0) == 1
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + revisionId)).data.get('status', '') == 'published'
        && getAfter(/databases/$(database)/documents/artifactPublicationRequests/$(artifactId + '_' + revisionId)).data.get('ownerId', '') == request.resource.data.ownerId;

      // Immutable. Admin delete only (moderation purge of removed content).
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /artifactPublicationRequests/{requestId} {
      // The ledger is owner/moderator territory — never guest-readable.
      allow get, list: if isAdmin()
        || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid);

      // Owner publishes: the ledger entry is created directly in `published`
      // status, id content-addressed to the (artifact, sanitized-payload)
      // pair, with private-revision provenance — and the live projection
      // (envelope + revision) must land in the same transaction, so a ledger
      // entry can never claim "published" without the artifact being live.
      allow create: if isFullUser()
        && request.resource.data.keys().hasOnly(['requestId', 'artifactId', 'artifactType', 'ownerId', 'ownerDisplayName', 'title', 'revisionId', 'contentDigest', 'digestAlgorithm', 'digestVersion', 'payload', 'posterUrl', 'sourceRevision', 'status', 'requestedAt', 'schemaVersion'])
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'published'
        && existsAfter(/databases/$(database)/documents/publicArtifacts/$(request.resource.data.get('artifactId', '')))
        && getAfter(/databases/$(database)/documents/publicArtifacts/$(request.resource.data.get('artifactId', ''))).data.get('currentRevisionId', '') == request.resource.data.get('revisionId', '')
        && getAfter(/databases/$(database)/documents/publicArtifacts/$(request.resource.data.get('artifactId', ''))).data.get('ownerId', '') == request.auth.uid
        && existsAfter(/databases/$(database)/documents/publicArtifacts/$(request.resource.data.get('artifactId', ''))/revisions/$(request.resource.data.get('revisionId', '')))
        && request.resource.data.get('requestId', '') == requestId
        && request.resource.data.get('artifactId', '').size() > 0
        && requestId == request.resource.data.artifactId + '_' + request.resource.data.get('revisionId', '')
        && request.resource.data.get('revisionId', '') == 'v1_' + request.resource.data.get('contentDigest', '')
        && request.resource.data.get('contentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('digestAlgorithm', '') == 'SHA-256'
        && request.resource.data.get('digestVersion', 0) == 1
        && request.resource.data.get('artifactType', '') in ['tunnel', 'mandala', 'scene']
        && request.resource.data.get('schemaVersion', 0) == 1
        && request.resource.data.get('sourceRevision', {}).get('artifactId', '') == request.resource.data.artifactId
        && request.resource.data.get('sourceRevision', {}).get('contentDigest', '').matches('^[a-f0-9]{64}$')
        && request.resource.data.get('sourceRevision', {}).get('revisionId', '') == 'v1_' + request.resource.data.get('sourceRevision', {}).get('contentDigest', '');

      // Status machine. Owner: withdraw published content (delisting in the
      // same transaction) and republish withdrawn content (relisting in the
      // same transaction). Admin: take down published content. `removed` is
      // terminal — no transition leaves it. Everything else about the ledger
      // entry is frozen after create.
      allow update: if (
          isAuthenticated()
          && resource.data.get('ownerId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestedAt'])
          && (
            (resource.data.get('status', '') == 'published'
              && request.resource.data.get('status', '') == 'withdrawn'
              && (
                !existsAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', '')))
                || getAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', ''))).data.get('currentRevisionId', '') != resource.data.get('revisionId', '')
              ))
            // Republish must relist this exact revision in this transaction.
            || (resource.data.get('status', '') == 'withdrawn'
              && request.resource.data.get('status', '') == 'published'
              && existsAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', '')))
              && getAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', ''))).data.get('currentRevisionId', '') == resource.data.get('revisionId', '')
              && getAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', ''))).data.get('ownerId', '') == resource.data.get('ownerId', '')
              && existsAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', ''))/revisions/$(resource.data.get('revisionId', ''))))
          )
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote'])
          && request.resource.data.get('reviewedBy', '') == request.auth.uid
          && resource.data.get('status', '') == 'published'
          && request.resource.data.get('status', '') == 'removed'
          // Takedown must delist in this same transaction.
          && (!existsAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', '')))
            || getAfter(/databases/$(database)/documents/publicArtifacts/$(resource.data.get('artifactId', ''))).data.get('currentRevisionId', '') != resource.data.get('revisionId', ''))
        );

      // Append-only audit ledger: no client deletes, ever.
      allow delete: if false;
    }

    // ============================================================================
    // PUBLIC HAND PATHS AND SOLO PROPS
    // ============================================================================

    // Public hand paths - browsable by anyone, writable by owner
    match /publicHandPaths/{pathId} {
      allow read: if true;
      allow create, update: if isFullUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // Public solo props - browsable by anyone, writable by owner
    match /publicSoloProps/{soloPropId} {
      allow read: if true;
      allow create, update: if isFullUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }

    // ============================================================================
    // GLOBAL ARROW ADJUSTMENTS
    // Admin-only collection for arrow position overrides
    // ============================================================================

    // Global arrow adjustments - admin-set arrow position overrides
    // These adjustments apply to ALL pictographs matching the same key
    // Document ID format: {placementFrame}|{oriKey}|{letter}|{turnsTuple}|{arrowKey}
    match /global_arrow_adjustments/{adjustmentId} {
      // Placement is presentation data: guests and signed-in users must render identically.
      allow read: if true;

      allow create, update: if isAdmin()
        && hasValidPlacementFrame()
        && adjustmentId.matches('^' + request.resource.data.placementFrame + '[|].*');
      allow delete: if isAdmin();
    }

    // Audit trail for arrow adjustment changes
    // Document ID: auto-generated
    match /global_arrow_adjustment_history/{entryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Append-only audit trail for DEFAULT placement changes. Immutable: admins
    // create + read, nobody updates or deletes (true history).
    match /default_arrow_adjustment_history/{entryId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Special arrow placement overrides - per-letter Firestore overrides for static JSON
    // Document ID format: {placementFrame}|{oriFolder}|{letter}|{turnsTuple}|{motionType}
    match /special_arrow_placements/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && hasValidPlacementFrame()
        && docId.matches('^' + request.resource.data.placementFrame + '[|].*');
      allow delete: if isAdmin();
    }

    // Default arrow placements — canonical baseline arrow positions (one doc per
    // {placementFrame}_{propType}_{motionType}). Readable by all (every arrow render needs them,
    // incl. guests / pre-auth), writable by admins.
    match /default_arrow_adjustments/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && hasValidPlacementFrame()
        && docId.matches('^' + request.resource.data.placementFrame + '_.*');
      allow delete: if isAdmin();
    }

    // ============================================================================
    // APP METRICS (Public Counters)
    // ============================================================================

    // App-wide metrics like global counters for the endless spinner
    // Public read, constrained increment-only writes for anonymous counters
    match /appMetrics/{metricId} {
      // ANYONE can read metrics (for displaying global counters)
      allow read: if true;

      // Only allow atomic +1 increment of totalGenerated — no other field changes
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalGenerated'])
        && request.resource.data.totalGenerated == resource.data.totalGenerated + 1;
      allow create, delete: if false;
    }

    // ============================================================================
    // LIVE BROADCAST (Synchronized Endless Spinner)
    // ============================================================================

    // Live broadcast state - everyone watches the same synchronized stream
    // Cloud Functions write via Admin SDK, clients only read
    match /liveBroadcast/{document=**} {
      // ANYONE can read the broadcast (no authentication required)
      // This enables the synchronized experience for all visitors
      allow read: if true;

      // No client writes - only Cloud Functions can update via Admin SDK
      // This ensures a single authoritative source for the broadcast
      allow write: if false;
    }

    // ============================================================================
    // USER LOCATIONS (Global Community Map)
    // ============================================================================

    // User location sharing for the global TKA community map
    // Users can share their coordinates to appear on the map
    // Privacy controlled by visibility field (public/private)
    match /userLocations/{userId} {
      // Anyone can read public locations (for the community map)
      // Users can read their own location regardless of visibility
      // Admins can read any location
      allow read: if resource.data.visibility == 'public'
        || isOwner(userId)
        || isAdmin();

      // Only the user can create or update their own location
      allow create, update: if isOwner(userId) && isFullUser();

      // Users can delete their own location, admins can delete any
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================================
    // SHOWCASE VIDEOS (Landing Page Video Curation)
    // ============================================================================

    // Showcase videos - uploaded from Instagram, curated for landing page
    // Authenticated users can read (admin module is access-controlled client-side)
    // Public can read approved videos (for landing page display)
    // Only admins can write
    match /showcaseVideos/{videoId} {
      // Allow read for:
      // 1. Any authenticated user (for admin curation UI)
      // 2. Unauthenticated users for approved videos (landing page)
      allow read: if isAuthenticated() || resource.data.approved == true;

      // Only admins can create/update/delete
      allow create, update, delete: if isAdmin();
    }

    // ============================================================================
    // USER REPORTS (Moderation System)
    // ============================================================================

    // User reports - community members can report problematic users
    // Users can read their own submitted reports
    // Admins can read all reports and update/delete them
    match /userReports/{reportId} {
      // Users can read their own reports, admins can read all
      allow read: if isAuthenticated()
        && (resource.data.reporterId == request.auth.uid || isAdmin());

      // Authenticated users can submit reports (not about themselves)
      allow create: if isFullUser()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid;

      // Only admins can update reports (status changes, resolution, etc.)
      allow update: if isAdmin();

      // Only admins can delete reports
      allow delete: if isAdmin();
    }

    // ============================================================================
    // CONTENT APPEALS (Content Moderation Appeals)
    // ============================================================================

    // Content appeals - users can appeal flagged content moderation decisions
    // Users can read/create their own appeals
    // Admins can read all appeals and resolve them
    match /contentAppeals/{appealId} {
      // Users can read their own appeals, admins can read all
      allow read: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Users can create appeals for their own content
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only admins can update appeals (resolve them)
      allow update: if isAdmin();

      // Only admins can delete appeals
      allow delete: if isAdmin();
    }

    // ============================================================================
    // HALL OF SHAME (Age-Gated Adult Content)
    // ============================================================================

    // Hall of Shame entries - age-verified users can browse, admins moderate
    match /hallOfShame/{sequenceId} {
      // Age-verified users can read approved, non-hidden entries
      // Users can always see their own entries (any status)
      // Admins can read all entries for moderation
      allow read: if isAdmin()
        || (isAuthenticated()
            && isAgeVerified()
            && (resource.data.status == 'approved' || resource.data.ownerId == request.auth.uid)
            && resource.data.hidden != true);

      // Users can submit their own sequences (pending status only)
      // Enforces initial values to prevent manipulation
      allow create: if isAuthenticated()
        && isFullUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.voteCount == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.featured == false
        && request.resource.data.hidden == false;

      // Only admins can approve/reject/feature/hide
      allow update: if isAdmin();

      // Users can delete their own pending submissions only
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Hall of Shame votes - one vote per user per sequence
    // Document ID format: {voterId}_{sequenceId} for uniqueness enforcement
    match /hallOfShameVotes/{voteId} {
      // Age-verified users can read votes
      allow read: if isAuthenticated() && isAgeVerified();

      // One vote per user per sequence (enforced by document ID pattern)
      allow create: if isAuthenticated()
        && isFullUser()
        && isAgeVerified()
        && voteId == request.auth.uid + '_' + request.resource.data.sequenceId
        && request.resource.data.voterId == request.auth.uid;

      // Votes cannot be changed or deleted (permanent)
      allow update, delete: if false;
    }

    // Hall of Shame rate limits - tracks daily submission count
    match /hallOfShameRateLimits/{limitId} {
      // Users can read/write their own rate limit docs
      allow read, create, update: if isAuthenticated()
        && limitId.matches(request.auth.uid + '_.*');
      allow delete: if isAdmin();
    }

    // Hall of Shame reports - for post-approval issue tracking
    match /hallOfShameReports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();

      // Age-verified users can submit reports
      allow create: if isAuthenticated()
        && isFullUser()
        && isAgeVerified()
        && request.resource.data.reporterId == request.auth.uid;

      // Reports cannot be modified or deleted
      allow update, delete: if false;
    }

    // ============================================================================
    // LOOP LABELS (Admin Labeling Tool)
    // ============================================================================

    // LOOP labels - admin tool for labeling sequences with LOOP patterns
    // Document ID is the sequence word (uppercase)
    match /loop-labels/{word} {
      // Authenticated users can read labels (needed for Browse to show LOOP icons)
      allow read: if isAuthenticated();

      // Only admins can write labels
      allow write: if isAdmin();
    }

    // ============================================================================
    // SYSTEM CATALOGS (Algorithmically Enumerated Sequence Pools)
    // ============================================================================

    // System catalogs - algorithmically enumerated source pools of sequences
    // (e.g., Level 1 LOOP catalog). Readable by all authenticated users,
    // writable by admins only. Distinct from released printable Decks, which
    // live in deckReleases/ below. Migrated from the legacy decks/ collection.
    match /catalogs/{catalogId} {
      // TnD catalogs are public teaching material (guest-readable, surfaced by
      // the "Start here" onboarding). The full enumerated LOOP catalogs stay
      // auth-gated. Discriminator: the catalog doc's `collection` field.
      allow read: if isAuthenticated() || resource.data.collection == "TnD";
      allow write: if isAdmin();

      // Sequences within a catalog. Guests may read a TnD catalog's sequences;
      // the parent's `collection` field gates this (get() reads the parent doc).
      match /sequences/{sequenceId} {
        allow read: if isAuthenticated()
          || get(/databases/$(database)/documents/catalogs/$(catalogId)).data.collection == "TnD";
        allow write: if isAdmin();
      }
    }

    // Legacy decks/ collection - migrated to catalogs/ above, retained as a
    // rollback safety net. Same rules. Remove once catalogs/ is verified live.
    match /decks/{deckId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Sequences within a deck
      match /sequences/{sequenceId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ============================================================================
    // DECK RELEASES (Sequential deck numbering + manifests)
    // ============================================================================

    match /deckReleases/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /manifests/{manifestId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ============================================================================
    // DEVELOPERS COLLECTION (Multi-Developer Access Control)
    // ============================================================================

    // Developers collection - the authority on who can access developer tools
    // Any approved developer can read the roster; only admin can manage it
    match /developers/{uid} {
      // Authenticated users can read their own record (needed for role lookup at login)
      // Approved developers can read all records (for list-developers command)
      allow read: if isAuthenticated() && request.auth.uid == uid
                  || isApprovedDeveloper();
      allow write: if isDeveloperAdmin();
    }

    // ============================================================================
    // AGENT SESSIONS (Developer CLI Sessions)
    // ============================================================================

    // Agent sessions - tracks active developer CLI sessions
    // Any approved developer can read/write session data
    match /agentSessions/{sessionId} {
      allow read, write: if isApprovedDeveloper();
    }

    // ============================================================================
    // MAIL COLLECTION (Email Trigger Extension)
    // ============================================================================

    // Mail collection - documents trigger the Firebase email extension
    // Approved developers can create mail documents; no reads needed
    match /mail/{mailId} {
      allow create: if isApprovedDeveloper();
      allow read: if false;
    }

    // ============================================================================
    // FESTIVAL HUB
    // ============================================================================

    // Festival directory — public read, admin write
    match /festivals/{festivalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      // Public attendance badges per festival
      match /attendance/{uid} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(uid);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Private application tracking per user
    match /userFestivalTracking/{userId}/tracked/{festivalId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Teaching portfolio (single doc per user)
    match /userProfiles/{userId}/workshopPortfolio/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Festival submissions (moderation queue)
    match /festivalSubmissions/{submissionId} {
      allow create: if isFullUser();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── STORE: PRODUCTS (public read) ──
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── STORE: ORDERS (admin only; Cloud Functions use the Admin SDK) ──
    // createCartCheckout writes a `pending` doc with `expiresAt` (now + 24h);
    // the Stripe webhook flips it to `paid` and DELETES `expiresAt`. A Firestore
    // TTL policy on `orders.expiresAt` reaps abandoned pending docs — it deletes
    // purely on the timestamp, so paid orders MUST clear the field (they do).
    // Never allow client writes here: prices/status are resolved server-side.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK bypasses rules; clients never write.
    }

    // ── STORE: SHOP WAITLIST (anyone may join, admin reads) ──
    // Coming Soon page collects emails for a launch announcement. Open create so
    // signed-out visitors can join; shape-checked; never client-readable/editable.
    match /shop_waitlist/{entryId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow update, delete: if false;
    }

    // Software-history submissions pass through the rate-limited server API.
    // The Admin SDK bypasses these rules; browser clients cannot write here.
    match /software_submissions/{entryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================================================
    // ACCOUNT DELETIONS (Tombstone — GDPR Art. 17(3) audit record)
    // ============================================================================

    // One doc per deleted account, 12-month retention (purged by a scheduled
    // function). The Auth onDelete trigger writes the identity fields via the
    // Admin SDK (bypasses these rules). The only client write is the optional
    // exit reason, made BEFORE deletion while the user is still authed — the
    // trigger merge-writes over it, so the reason survives.
    match /accountDeletions/{uid} {
      allow read: if isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'reason'])
        && request.resource.data.uid == uid
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string
                && request.resource.data.reason.size() <= 500));

      // Purge is Admin SDK only.
      allow delete: if false;
    }

    // Instagram custom-auth handshake. The random state document contains no
    // provider token; its owner may watch only that exact document for callback
    // completion. All writes and identity lookups stay Admin-SDK-only.
    match /instagramOAuthStates/{state} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.requesterUid;
      allow write: if false;
    }

    match /instagramAuthLinks/{linkId} {
      allow read, write: if false;
    }

    // Meta publish-connect handshake. Same shape as the sign-in states above:
    // the owner may watch their own random state document for the popup to
    // report back; nothing in it is a credential.
    match /metaConnectStates/{state} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.requesterUid;
      allow write: if false;
    }

    // Instagram and Facebook Page access tokens. Admin SDK only — no client
    // read path exists, and none should be added. What the UI needs to render
    // lives in metaPublishStatus below.
    match /metaPublishConnections/{uid} {
      allow read, write: if false;
    }

    // Token-free mirror of the above: which accounts are connected, under what
    // name, until when. Owner-readable so the share sheet can subscribe; only
    // the Admin SDK writes it.
    match /metaPublishStatus/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /instagramDataDeletionRequests/{confirmationCode} {
      allow read, write: if false;
    }

    // ============================================================================
    // ERROR TELEMETRY (Passive Error Reporting)
    // ============================================================================

    // Error telemetry — passive client-side error reports.
    // Doc IDs are deterministic ({utcDay}_{hash(key)}), so clients dedup by
    // writing straight to a known ID — no reads needed (reads stay denied).
    // create/update: true — errors (and their recurrences) happen before auth
    // initializes. Updates may not touch `resolved`: that flag is the admin
    // triage state, set only via Admin SDK scripts.
    // read/delete: false — access via Admin SDK / scripts only.
    match /errorTelemetry/{docId} {
      allow create: if true;
      allow update: if !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['resolved']);
      allow read: if false;
      allow delete: if false;
    }

    // ============================================================================
    // EXPLICIT DENY FOR UNMATCHED PATHS
    // Any collection not explicitly defined above is denied by default
    // ============================================================================

    // Firestore denies by default, but we make it explicit for clarity
    // If you need a new collection, add explicit rules above this comment
  }
}
